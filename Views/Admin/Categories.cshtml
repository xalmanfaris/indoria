@model List<AuraLiving.Models.CategoryViewModel>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Categories & Brand Management";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold admin-text-title mb-1">Categories & Authorized Brands</h2>
        <p class="admin-text-muted mb-0 small">Manage product categories, hero imagery, and brand partners.</p>
    </div>
    <div>
        <button class="btn btn-warning rounded-pill px-4 fw-semibold" onclick="alert('Category creation modal triggered');">
            <i class="bi bi-plus-lg me-1"></i> Add Category
        </button>
    </div>
</div>

<!-- Categories Cards -->
<div class="row g-3 mb-4">
    @foreach (var cat in Model)
    {
        <div class="col-12 col-md-6 col-xl-4">
            <div class="stat-card-glass p-3 rounded-4 h-100 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <div class="rounded-3 bg-warning bg-opacity-10 text-warning p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                <i class="bi @(string.IsNullOrEmpty(cat.Icon) ? "bi-grid-fill" : cat.Icon) fs-5"></i>
                            </div>
                            <h5 class="fw-bold admin-text-title mb-0">@cat.Name</h5>
                        </div>
                        <span class="badge bg-warning bg-opacity-25 text-warning rounded-pill px-2.5 py-1 small">
                            @cat.ProductCount Products
                        </span>
                    </div>

                    <p class="small admin-text-muted mb-3 line-clamp-2" style="font-size: 0.85rem;">@cat.Description</p>
                </div>

                <div class="d-flex align-items-center justify-content-between pt-2 border-top border-secondary border-opacity-10">
                    <small class="text-warning text-truncate me-2"><i class="bi bi-link-45deg me-1"></i>/category/@cat.Slug</small>
                    <div class="btn-group btn-group-sm">
                        <button class="btn btn-sm btn-outline-secondary rounded-pill px-2.5" title="Edit" onclick="alert('Edit @cat.Name');">
                            <i class="bi bi-pencil me-1"></i>Edit
                        </button>
                        <a href="/category/@cat.Slug" target="_blank" class="btn btn-sm btn-outline-warning rounded-pill px-2.5" title="View">
                            <i class="bi bi-box-arrow-up-right me-1"></i>View
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Authorized Brands Section -->
<div class="stat-card-glass p-4 rounded-4">
    <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
        <div>
            <h5 class="fw-bold admin-text-title mb-0">Authorized Brand Partners</h5>
            <div class="small admin-text-muted">Registered manufacturer partnerships</div>
        </div>
        <button class="btn btn-outline-warning btn-sm rounded-pill px-3" onclick="alert('Add brand clicked');">
            <i class="bi bi-plus-circle me-1"></i> Add Brand
        </button>
    </div>

    <div class="row g-2">
        @foreach (var brand in new[] { "Bosch", "Samsung", "LG", "Haier", "Whirlpool", "IFB" })
        {
            <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                <div class="p-2.5 rounded-3 bg-body-tertiary border text-center">
                    <div class="fw-bold admin-text-title small">@brand</div>
                    <div class="extra-small text-success mt-0.5"><i class="bi bi-patch-check-fill"></i> Authorized</div>
                </div>
            </div>
        }
    </div>
</div>
