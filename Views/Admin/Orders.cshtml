@model List<AuraLiving.Models.OrderViewModel>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Order Fulfillment & Processing";
    var selectedStatus = ViewBag.SelectedStatus as string ?? "all";

    var totalOrders = Model?.Count ?? 0;
    var processingCount = Model?.Count(o => o.Status == "Processing") ?? 0;
    var shippedCount = Model?.Count(o => o.Status == "Shipped" || o.Status == "In Transit") ?? 0;
    var deliveredCount = Model?.Count(o => o.Status == "Delivered") ?? 0;
    var cancelledCount = Model?.Count(o => o.Status == "Cancelled") ?? 0;
}

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold admin-text-title mb-1 fs-3 fs-md-2">Order Fulfillment &amp; Logistics</h2>
        <p class="admin-text-muted mb-0 small">Track customer shipments, manage White-Glove installation slots, and update fulfillment statuses.</p>
    </div>
    <div class="d-flex align-items-center gap-2 w-100 w-md-auto">
        <button class="btn btn-outline-secondary rounded-pill px-3.5 py-2 w-100 w-md-auto d-flex align-items-center justify-content-center gap-2" onclick="window.print()">
            <i class="bi bi-printer"></i> <span>Print Manifest</span>
        </button>
    </div>
</div>

<!-- KPI Overview Cards -->
<div class="row g-2.5 g-sm-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="stat-card-glass p-2.5 p-sm-3.5 h-100">
            <div class="d-flex align-items-center gap-2 gap-sm-3">
                <div class="stat-icon-wrapper bg-primary bg-opacity-10 text-primary flex-shrink-0 mb-0" style="width: 40px; height: 40px; min-width: 40px; font-size: 1.15rem; border-radius: 10px;">
                    <i class="bi bi-bag-check-fill"></i>
                </div>
                <div class="min-w-0 flex-grow-1">
                    <span class="admin-text-muted fw-bold text-uppercase text-truncate d-block" style="font-size: 0.68rem; letter-spacing: 0.3px;">Total Orders</span>
                    <h3 class="fw-bold admin-text-title mt-0 mb-0 fs-4 fs-sm-3">@totalOrders</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card-glass p-2.5 p-sm-3.5 h-100">
            <div class="d-flex align-items-center gap-2 gap-sm-3">
                <div class="stat-icon-wrapper bg-warning bg-opacity-10 text-warning flex-shrink-0 mb-0" style="width: 40px; height: 40px; min-width: 40px; font-size: 1.15rem; border-radius: 10px;">
                    <i class="bi bi-clock-history"></i>
                </div>
                <div class="min-w-0 flex-grow-1">
                    <span class="admin-text-muted fw-bold text-uppercase text-truncate d-block" style="font-size: 0.68rem; letter-spacing: 0.3px;">Processing</span>
                    <h3 class="fw-bold text-warning mt-0 mb-0 fs-4 fs-sm-3">@processingCount</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card-glass p-2.5 p-sm-3.5 h-100">
            <div class="d-flex align-items-center gap-2 gap-sm-3">
                <div class="stat-icon-wrapper bg-info bg-opacity-10 text-info flex-shrink-0 mb-0" style="width: 40px; height: 40px; min-width: 40px; font-size: 1.15rem; border-radius: 10px;">
                    <i class="bi bi-truck"></i>
                </div>
                <div class="min-w-0 flex-grow-1">
                    <span class="admin-text-muted fw-bold text-uppercase text-truncate d-block" style="font-size: 0.68rem; letter-spacing: 0.3px;">In-Transit</span>
                    <h3 class="fw-bold text-info mt-0 mb-0 fs-4 fs-sm-3">@shippedCount</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card-glass p-2.5 p-sm-3.5 h-100">
            <div class="d-flex align-items-center gap-2 gap-sm-3">
                <div class="stat-icon-wrapper bg-success bg-opacity-10 text-success flex-shrink-0 mb-0" style="width: 40px; height: 40px; min-width: 40px; font-size: 1.15rem; border-radius: 10px;">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
                <div class="min-w-0 flex-grow-1">
                    <span class="admin-text-muted fw-bold text-uppercase text-truncate d-block" style="font-size: 0.68rem; letter-spacing: 0.3px;">Delivered</span>
                    <h3 class="fw-bold text-success mt-0 mb-0 fs-4 fs-sm-3">@deliveredCount</h3>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Status Filter Tabs & Search Bar -->
<div class="stat-card-glass p-3 mb-4">
    <div class="d-flex flex-column flex-md-row align-items-stretch align-items-md-center justify-content-between gap-3">
        <div class="nav nav-pills gap-2 flex-nowrap overflow-x-auto pb-2 pb-md-0 text-nowrap">
            <a href="/admin/orders?status=all" class="nav-link rounded-pill px-3 py-1.5 fs-7 @(selectedStatus == "all" ? "active bg-warning text-dark fw-bold" : "admin-text-muted")">
                All (@totalOrders)
            </a>
            <a href="/admin/orders?status=Processing" class="nav-link rounded-pill px-3 py-1.5 fs-7 @(selectedStatus == "Processing" ? "active bg-warning text-dark fw-bold" : "admin-text-muted")">
                <i class="bi bi-clock-history me-1"></i> Processing (@processingCount)
            </a>
            <a href="/admin/orders?status=Shipped" class="nav-link rounded-pill px-3 py-1.5 fs-7 @(selectedStatus == "Shipped" ? "active bg-info text-dark fw-bold" : "admin-text-muted")">
                <i class="bi bi-truck me-1"></i> In-Transit (@shippedCount)
            </a>
            <a href="/admin/orders?status=Delivered" class="nav-link rounded-pill px-3 py-1.5 fs-7 @(selectedStatus == "Delivered" ? "active bg-success text-white fw-bold" : "admin-text-muted")">
                <i class="bi bi-check-circle-fill me-1"></i> Delivered (@deliveredCount)
            </a>
            <a href="/admin/orders?status=Cancelled" class="nav-link rounded-pill px-3 py-1.5 fs-7 @(selectedStatus == "Cancelled" ? "active bg-danger text-white fw-bold" : "admin-text-muted")">
                <i class="bi bi-x-circle-fill me-1"></i> Cancelled (@cancelledCount)
            </a>
        </div>

        <div class="w-100 w-md-auto" style="min-width: 220px;">
            <div class="input-group">
                <span class="input-group-text border-end-0 bg-body-tertiary text-muted"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control border-start-0 rounded-end-pill px-3" id="adminOrderSearchInput" placeholder="Search Order ID or Customer..." onkeyup="filterAdminOrders(this.value)">
            </div>
        </div>
    </div>
</div>

<!-- Orders List -->
<div class="d-flex flex-column gap-3" id="adminOrdersContainer">
    @if (!Model.Any())
    {
        <div class="stat-card-glass text-center py-5 admin-text-muted">
            <i class="bi bi-box2 fs-1 d-block mb-2"></i>
            No orders found matching the filter criteria.
        </div>
    }
    else
    {
        @foreach (var order in Model)
        {
            var customerFullName = order.ShippingAddress?.FullName ?? order.CustomerName ?? "";
            <div class="stat-card-glass p-3 p-sm-4 admin-order-card" data-order-id="@order.Id.ToLower()" data-customer-name="@customerFullName.ToLower()">
                <!-- Order Card Top Bar -->
                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 pb-3 border-bottom">
                    <div class="min-w-0">
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <span class="fs-5 fw-bold admin-text-title font-monospace text-truncate" style="max-width: 240px;">Order #@order.Id</span>
                            @if (order.Status == "Processing")
                            {
                                <span class="badge bg-warning bg-opacity-20 text-warning border border-warning rounded-pill px-2.5 py-1 fs-8">Processing</span>
                            }
                            else if (order.Status == "Shipped" || order.Status == "In Transit")
                            {
                                <span class="badge bg-info bg-opacity-20 text-info border border-info rounded-pill px-2.5 py-1 fs-8">In Transit</span>
                            }
                            else if (order.Status == "Delivered")
                            {
                                <span class="badge bg-success bg-opacity-20 text-success border border-success rounded-pill px-2.5 py-1 fs-8">Delivered</span>
                            }
                            else if (order.Status == "Cancelled")
                            {
                                <span class="badge bg-danger bg-opacity-20 text-danger border border-danger rounded-pill px-2.5 py-1 fs-8">Cancelled</span>
                            }
                            else
                            {
                                <span class="badge bg-primary bg-opacity-20 text-primary border border-primary rounded-pill px-2.5 py-1 fs-8">@order.Status</span>
                            }
                        </div>
                        <div class="small admin-text-muted mt-1 fs-8"><i class="bi bi-calendar-event me-1"></i> Placed on <span class="admin-text-title fw-semibold">@order.OrderDate.ToString("MMM dd, yyyy • hh:mm tt")</span></div>
                    </div>
                    <div class="text-start text-sm-end w-100 w-sm-auto">
                        <div class="fs-5 fw-bold text-warning">₹@order.TotalAmount.ToString("N0")</div>
                        <div class="small admin-text-muted fs-8">Payment: <span class="badge bg-body-tertiary border text-body font-monospace">@order.PaymentMethod</span></div>
                    </div>
                </div>

                <!-- Order Content Grid -->
                <div class="row g-3 mt-1">
                    <!-- Items Purchased -->
                    <div class="col-12 col-lg-7 border-end-lg mb-2 mb-lg-0">
                        <div class="small fw-bold text-uppercase admin-text-muted mb-2 fs-8"><i class="bi bi-box-seam text-warning me-1"></i> Purchased Suite Products (@order.Items.Count)</div>
                        <div class="d-flex flex-column gap-2">
                            @foreach (var item in order.Items)
                            {
                                <div class="d-flex align-items-center justify-content-between p-2 rounded-3 bg-light border gap-2">
                                    <div class="d-flex align-items-center gap-2.5 min-w-0 flex-grow-1" style="min-width: 0;">
                                        <img src="@item.ProductImage" alt="@item.ProductName" class="rounded-2 flex-shrink-0" style="width: 46px; height: 46px; min-width: 46px; object-fit: cover;" referrerpolicy="no-referrer" onerror="this.onerror=null;this.src='/images/homixa_hero_appliances.jpg';" />
                                        <div class="min-w-0 flex-grow-1" style="min-width: 0;">
                                            <div class="fw-semibold admin-text-title fs-7 text-truncate" title="@item.ProductName">@item.ProductName</div>
                                            <div class="small admin-text-muted fs-8">Qty: @item.Quantity &times; ₹@item.UnitPrice.ToString("N0")</div>
                                        </div>
                                    </div>
                                    <div class="fw-bold admin-text-title fs-7 pe-2 text-nowrap flex-shrink-0">
                                        ₹@((item.UnitPrice * item.Quantity).ToString("N0"))
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Customer Address & Installation Info -->
                    <div class="col-12 col-lg-5">
                        <div class="small fw-bold text-uppercase admin-text-muted mb-2 fs-8"><i class="bi bi-geo-alt text-warning me-1"></i> Customer &amp; Delivery Address</div>
                        <div class="p-3 rounded-3 bg-light border">
                            <div class="fw-bold admin-text-title mb-1 text-truncate"><i class="bi bi-person-fill text-warning me-1"></i> @(string.IsNullOrEmpty(order.ShippingAddress?.FullName) ? order.CustomerName : order.ShippingAddress.FullName)</div>
                            <div class="small admin-text-muted mb-1 text-break"><i class="bi bi-geo-alt-fill me-1"></i> @order.ShippingAddress?.StreetAddress, @order.ShippingAddress?.City, @order.ShippingAddress?.State - @order.ShippingAddress?.Pincode</div>
                            <div class="small admin-text-muted"><i class="bi bi-telephone-fill me-1"></i> @(string.IsNullOrEmpty(order.ShippingAddress?.Phone) ? "Not Provided" : order.ShippingAddress.Phone)</div>
                            
                            <!-- White-Glove Care Slot Indicator -->
                            <div class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-30 rounded-3 p-2 w-100 mt-2 d-flex align-items-center gap-2 text-start text-wrap">
                                <i class="bi bi-tools text-warning fs-6 flex-shrink-0"></i>
                                <div>
                                    <strong class="d-block text-warning" style="font-size: 0.78rem;">White-Glove Installation Assigned</strong>
                                    <span class="admin-text-muted" style="font-size: 0.73rem;">Civil plumbing &amp; unboxing slot verified</span>
                                </div>
                            </div>
                        </div>

                        <!-- Cancellation Reason Alert Box for Admin -->
                        @if (order.Status == "Cancelled" || !string.IsNullOrEmpty(order.CancellationReason))
                        {
                            <div class="p-3 rounded-3 bg-danger bg-opacity-10 border border-danger border-opacity-30 mt-3">
                                <div class="small fw-bold text-danger mb-1"><i class="bi bi-x-circle-fill me-1"></i> Customer Cancellation Reason:</div>
                                <div class="small text-danger fw-semibold" style="word-break: break-word;">@(string.IsNullOrEmpty(order.CancellationReason) ? "Customer cancelled order." : order.CancellationReason)</div>
                                @if (order.CancellationDate.HasValue)
                                {
                                    <div class="text-muted small mt-1 fs-8"><i class="bi bi-clock me-1"></i> Cancelled on @order.CancellationDate.Value.ToString("MMM dd, yyyy • hh:mm tt")</div>
                                }
                            </div>
                        }

                        <!-- Order Status Control Buttons -->
                        <div class="mt-3 pt-3 border-top">
                            <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-1">
                                <span class="small fw-bold text-uppercase admin-text-muted fs-8"><i class="bi bi-arrow-repeat text-warning me-1"></i> Update Status:</span>
                                <span class="badge @(order.Status switch {
                                    "Processing" => "bg-warning text-dark",
                                    "Shipped" => "bg-info text-dark",
                                    "Delivered" => "bg-success text-white",
                                    "Cancelled" => "bg-danger text-white",
                                    _ => "bg-secondary text-white"
                                }) rounded-pill px-2.5 py-1 font-weight-bold fs-8">
                                    Current: @order.Status
                                </span>
                            </div>
                            
                            <!-- Responsive Touch-Friendly Status Buttons -->
                            <div class="row g-2 row-cols-2 row-cols-sm-4">
                                <div class="col">
                                    <button type="button" class="btn btn-sm w-100 py-2 fs-8 fw-semibold rounded-pill d-flex align-items-center justify-content-center gap-1 @(order.Status == "Processing" ? "btn-warning text-dark fw-bold active shadow-sm" : "btn-outline-secondary border-opacity-25 text-body")" onclick="updateAdminOrderStatus('@order.Id', 'Processing')">
                                        <i class="bi bi-clock-history"></i> <span class="text-truncate">Processing</span>
                                    </button>
                                </div>
                                <div class="col">
                                    <button type="button" class="btn btn-sm w-100 py-2 fs-8 fw-semibold rounded-pill d-flex align-items-center justify-content-center gap-1 @(order.Status == "Shipped" || order.Status == "In Transit" ? "btn-info text-dark fw-bold active shadow-sm" : "btn-outline-secondary border-opacity-25 text-body")" onclick="updateAdminOrderStatus('@order.Id', 'Shipped')">
                                        <i class="bi bi-truck"></i> <span class="text-truncate">Shipped</span>
                                    </button>
                                </div>
                                <div class="col">
                                    <button type="button" class="btn btn-sm w-100 py-2 fs-8 fw-semibold rounded-pill d-flex align-items-center justify-content-center gap-1 @(order.Status == "Delivered" ? "btn-success text-white fw-bold active shadow-sm" : "btn-outline-secondary border-opacity-25 text-body")" onclick="updateAdminOrderStatus('@order.Id', 'Delivered')">
                                        <i class="bi bi-check-circle-fill"></i> <span class="text-truncate">Delivered</span>
                                    </button>
                                </div>
                                <div class="col">
                                    <button type="button" class="btn btn-sm w-100 py-2 fs-8 fw-semibold rounded-pill d-flex align-items-center justify-content-center gap-1 @(order.Status == "Cancelled" ? "btn-danger text-white fw-bold active shadow-sm" : "btn-outline-secondary border-opacity-25 text-body")" onclick="updateAdminOrderStatus('@order.Id', 'Cancelled')">
                                        <i class="bi bi-x-circle-fill"></i> <span class="text-truncate">Cancelled</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@section Scripts {
    <script>
        function filterAdminOrders(query) {
            const term = query.toLowerCase().trim();
            document.querySelectorAll('.admin-order-card').forEach(card => {
                const orderId = card.getAttribute('data-order-id') || '';
                const customerName = card.getAttribute('data-customer-name') || '';
                card.style.display = (orderId.includes(term) || customerName.includes(term)) ? '' : 'none';
            });
        }

        async function updateAdminOrderStatus(orderId, newStatus) {
            if (!confirm(`Are you sure you want to change Order #${orderId} status to '${newStatus}'?`)) return;

            try {
                const response = await fetch(`/api/v1/orders/${orderId}/status`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ status: newStatus })
                });

                const data = await response.json();
                if (response.ok && data.success) {
                    if (typeof showAuraToast === 'function') {
                        showAuraToast(data.message || `Order #${orderId} updated to ${newStatus}`, 'success');
                    } else {
                        alert(data.message || `Order status updated to ${newStatus}`);
                    }
                    setTimeout(() => window.location.reload(), 800);
                } else {
                    alert(data.message || 'Error updating order status');
                }
            } catch (err) {
                console.error(err);
                alert('An error occurred while updating status');
            }
        }
    </script>
}
