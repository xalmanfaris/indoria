@model List<AuraLiving.Models.ReturnRequestViewModel>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Returns & Replacements Management";
    var selectedStatus = ViewBag.SelectedStatus as string ?? "all";

    var totalClaims = Model?.Count ?? 0;
    var reviewCount = Model?.Count(r => r.Status == "Under Review") ?? 0;
    var approvedCount = Model?.Count(r => r.Status == "Approved" || r.Status == "Pickup Scheduled") ?? 0;
    var completedCount = Model?.Count(r => r.Status == "Completed") ?? 0;
}

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div class="min-w-0">
        <h2 class="fw-bold admin-text-title mb-1 fs-3 fs-md-2 text-break">Returns &amp; Replacements Console</h2>
        <p class="admin-text-muted mb-0 small">Review customer doorstep returns, inspect warranty claims, and manage refund/replacement approvals.</p>
    </div>
    <div class="d-flex align-items-center gap-2 w-100 w-md-auto">
        <button class="btn btn-outline-secondary rounded-pill px-3.5 py-2 w-100 w-md-auto d-flex align-items-center justify-content-center gap-2" onclick="window.print()">
            <i class="bi bi-printer"></i> <span>Print Manifest</span>
        </button>
    </div>
</div>

<!-- KPI Overview Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="stat-card-glass p-2.5 p-sm-3.5 h-100">
            <div class="d-flex align-items-center gap-2 gap-sm-3">
                <div class="stat-icon-wrapper bg-primary bg-opacity-10 text-primary flex-shrink-0 mb-0" style="width: 40px; height: 40px; min-width: 40px; font-size: 1.15rem; border-radius: 10px;">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </div>
                <div class="min-w-0 flex-grow-1">
                    <span class="admin-text-muted fw-bold text-uppercase text-truncate d-block" style="font-size: 0.68rem; letter-spacing: 0.3px;">Total Claims</span>
                    <h3 class="fw-bold admin-text-title mt-0 mb-0 fs-4 fs-sm-3">@totalClaims</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card-glass p-2.5 p-sm-3.5 h-100">
            <div class="d-flex align-items-center gap-2 gap-sm-3">
                <div class="stat-icon-wrapper bg-warning bg-opacity-10 text-warning flex-shrink-0 mb-0" style="width: 40px; height: 40px; min-width: 40px; font-size: 1.15rem; border-radius: 10px;">
                    <i class="bi bi-clock-history"></i>
                </div>
                <div class="min-w-0 flex-grow-1">
                    <span class="admin-text-muted fw-bold text-uppercase text-truncate d-block" style="font-size: 0.68rem; letter-spacing: 0.3px;">Under Review</span>
                    <h3 class="fw-bold text-warning mt-0 mb-0 fs-4 fs-sm-3">@reviewCount</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card-glass p-2.5 p-sm-3.5 h-100">
            <div class="d-flex align-items-center gap-2 gap-sm-3">
                <div class="stat-icon-wrapper bg-info bg-opacity-10 text-info flex-shrink-0 mb-0" style="width: 40px; height: 40px; min-width: 40px; font-size: 1.15rem; border-radius: 10px;">
                    <i class="bi bi-truck"></i>
                </div>
                <div class="min-w-0 flex-grow-1">
                    <span class="admin-text-muted fw-bold text-uppercase text-truncate d-block" style="font-size: 0.68rem; letter-spacing: 0.3px;">Approved / Pickup</span>
                    <h3 class="fw-bold text-info mt-0 mb-0 fs-4 fs-sm-3">@approvedCount</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card-glass p-2.5 p-sm-3.5 h-100">
            <div class="d-flex align-items-center gap-2 gap-sm-3">
                <div class="stat-icon-wrapper bg-success bg-opacity-10 text-success flex-shrink-0 mb-0" style="width: 40px; height: 40px; min-width: 40px; font-size: 1.15rem; border-radius: 10px;">
                    <i class="bi bi-check-all"></i>
                </div>
                <div class="min-w-0 flex-grow-1">
                    <span class="admin-text-muted fw-bold text-uppercase text-truncate d-block" style="font-size: 0.68rem; letter-spacing: 0.3px;">Completed</span>
                    <h3 class="fw-bold text-success mt-0 mb-0 fs-4 fs-sm-3">@completedCount</h3>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Status Filter Tabs & Mobile Search Bar -->
<div class="stat-card-glass p-3 mb-4">
    <div class="d-flex flex-column flex-md-row align-items-stretch align-items-md-center justify-content-between gap-3">
        <div class="nav nav-pills gap-2 flex-nowrap overflow-x-auto pb-2 pb-md-0 text-nowrap">
            <a href="/admin/returns?status=all" class="nav-link rounded-pill px-3 py-1.5 fs-7 @(selectedStatus == "all" ? "active bg-warning text-dark fw-bold" : "admin-text-muted")">
                All Claims (@totalClaims)
            </a>
            <a href="/admin/returns?status=Under Review" class="nav-link rounded-pill px-3 py-1.5 fs-7 @(selectedStatus == "Under Review" ? "active bg-warning text-dark fw-bold" : "admin-text-muted")">
                <i class="bi bi-clock-history me-1"></i> Under Review (@reviewCount)
            </a>
            <a href="/admin/returns?status=Approved" class="nav-link rounded-pill px-3 py-1.5 fs-7 @(selectedStatus == "Approved" ? "active bg-info text-dark fw-bold" : "admin-text-muted")">
                <i class="bi bi-check-circle me-1"></i> Approved (@Model.Count(r => r.Status == "Approved"))
            </a>
            <a href="/admin/returns?status=Pickup Scheduled" class="nav-link rounded-pill px-3 py-1.5 fs-7 @(selectedStatus == "Pickup Scheduled" ? "active bg-primary text-white fw-bold" : "admin-text-muted")">
                <i class="bi bi-truck me-1"></i> Pickup Scheduled (@Model.Count(r => r.Status == "Pickup Scheduled"))
            </a>
            <a href="/admin/returns?status=Completed" class="nav-link rounded-pill px-3 py-1.5 fs-7 @(selectedStatus == "Completed" ? "active bg-success text-white fw-bold" : "admin-text-muted")">
                <i class="bi bi-check-all me-1"></i> Completed (@completedCount)
            </a>
        </div>

        <div class="w-100 w-md-auto" style="min-width: 220px;">
            <div class="input-group">
                <span class="input-group-text border-end-0 bg-body-tertiary text-muted"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control border-start-0 rounded-end-pill px-3" placeholder="Search Claim ID, Order, Customer..." onkeyup="filterAdminReturns(this.value)">
            </div>
        </div>
    </div>
</div>

<!-- Returns List -->
<div class="d-flex flex-column gap-3" id="adminReturnsContainer">
    @if (!Model.Any())
    {
        <div class="stat-card-glass text-center py-5 admin-text-muted">
            <i class="bi bi-arrow-counterclockwise fs-1 d-block mb-2"></i>
            No return or replacement claims found matching the criteria.
        </div>
    }
    else
    {
        @foreach (var ret in Model)
        {
            <div class="stat-card-glass p-3 p-sm-4 admin-return-card overflow-hidden" data-search-term="@ret.Id.ToLower() @ret.OrderId.ToLower() @ret.CustomerName.ToLower() @ret.CustomerEmail.ToLower()">
                <!-- Header Info Row -->
                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 pb-3 border-bottom">
                    <div class="min-w-0 flex-grow-1">
                        <div class="d-flex flex-wrap align-items-center gap-1.5">
                            <span class="fs-6 fw-bold admin-text-title font-monospace text-truncate" style="max-width: 100%;">Claim #@ret.Id</span>
                            <span class="badge bg-secondary border text-white rounded-pill px-2.5 fs-8 text-truncate">Order #@ret.OrderId</span>
                            <span class="badge @(ret.Type == "Replacement" ? "bg-info text-dark" : "bg-primary text-white") bg-opacity-20 border rounded-pill px-2.5 fs-8">@ret.Type Request</span>
                            <span class="badge @(ret.Status == "Completed" ? "bg-success text-white" : ret.Status == "Rejected" ? "bg-danger text-white" : "bg-warning text-dark") rounded-pill px-2.5 fs-8">@ret.Status</span>
                        </div>
                        <div class="small admin-text-muted mt-1 fs-8"><i class="bi bi-calendar-event me-1"></i> Requested on <span class="admin-text-title fw-semibold">@ret.FormattedDate</span></div>
                    </div>
                    <div class="text-start text-sm-end w-100 w-sm-auto flex-shrink-0">
                        <div class="fs-5 fw-bold text-warning">₹@ret.RefundAmount.ToString("N0")</div>
                        <div class="small admin-text-muted fs-8 text-break">Customer: <span class="admin-text-title fw-semibold">@ret.CustomerName</span> <span class="text-muted text-break">(@ret.CustomerEmail)</span></div>
                    </div>
                </div>

                <!-- Main Content Row -->
                <div class="row g-3 mt-1">
                    <!-- Product & Customer Details -->
                    <div class="col-12 col-lg-7 border-end-lg mb-2 mb-lg-0">
                        <div class="small fw-bold text-uppercase admin-text-muted mb-2 fs-8 text-truncate"><i class="bi bi-box-seam text-warning me-1"></i> Item &amp; Doorstep Claim Reason</div>
                        <div class="p-2.5 p-sm-3 rounded-3 bg-light border overflow-hidden">
                            <!-- Product Image & Name Header -->
                            <div class="d-flex align-items-start gap-2.5 mb-2.5 overflow-hidden">
                                <img src="@ret.ProductImage" alt="@ret.ProductName" class="rounded-2 flex-shrink-0" style="width: 48px; height: 48px; min-width: 48px; object-fit: cover; background: #fff;" referrerpolicy="no-referrer" onerror="this.onerror=null;this.src='/images/homixa_hero_appliances.jpg';" />
                                <div class="min-w-0 flex-grow-1 overflow-hidden" style="min-width: 0;">
                                    <h6 class="fw-bold admin-text-title mb-1 lh-sm text-break" style="font-size: 0.95rem; word-break: break-word; overflow-wrap: anywhere;">@ret.ProductName</h6>
                                    <div class="small admin-text-muted fs-8">Claim Type: <span class="badge bg-secondary bg-opacity-20 text-body border px-2 py-0.5">@ret.Type</span></div>
                                </div>
                            </div>

                            <!-- Claim Reason Box (Full-Width Responsive Alert Badge) -->
                            <div class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-30 rounded-3 p-2.5 w-100 text-start text-wrap lh-sm mb-2" style="font-size: 0.82rem; word-break: break-word; overflow-wrap: anywhere;">
                                <i class="bi bi-exclamation-triangle-fill me-1 text-danger"></i>
                                <strong>Claim Reason:</strong> @ret.Reason
                            </div>

                            <!-- Customer Notes Box -->
                            @if (!string.IsNullOrEmpty(ret.Description))
                            {
                                <div class="p-2.5 rounded-3 bg-body-tertiary border mt-2 small admin-text-muted text-break" style="word-break: break-word; overflow-wrap: anywhere;">
                                    <strong class="admin-text-title d-block mb-1 fs-8"><i class="bi bi-chat-left-text text-warning me-1"></i> Customer Detailed Notes:</strong>
                                    <span class="text-body fs-8">@ret.Description</span>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Admin Action & Status Control -->
                    <div class="col-12 col-lg-5">
                        <div class="small fw-bold text-uppercase admin-text-muted mb-2 fs-8 text-truncate"><i class="bi bi-sliders text-warning me-1"></i> Action &amp; Claim Management</div>
                        @if (!string.IsNullOrEmpty(ret.AdminNotes))
                        {
                            <div class="p-2.5 rounded-3 bg-warning bg-opacity-10 border border-warning border-opacity-30 mb-3 small text-body text-break">
                                <strong>Admin Remarks:</strong> @ret.AdminNotes
                            </div>
                        }

                        <div class="d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between gap-2 p-3 rounded-3 bg-light border">
                            <div class="small admin-text-muted fw-semibold text-nowrap">Update Claim Status:</div>
                            <div class="dropdown w-100 w-sm-auto">
                                <button class="btn btn-warning btn-sm dropdown-toggle rounded-pill px-3 py-2 w-100 fw-bold text-dark d-flex align-items-center justify-content-between gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span><i class="bi bi-pencil-square me-1"></i> Change Status</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg w-100" style="max-width: 100%;">
                                    <li><a class="dropdown-item py-2" href="#" onclick="updateReturnStatus('@ret.Id', 'Approved')"><i class="bi bi-check-circle me-2 text-success fs-6"></i> Approve Request</a></li>
                                    <li><a class="dropdown-item py-2" href="#" onclick="updateReturnStatus('@ret.Id', 'Pickup Scheduled')"><i class="bi bi-truck me-2 text-primary fs-6"></i> Schedule Doorstep Pickup</a></li>
                                    <li><a class="dropdown-item py-2" href="#" onclick="updateReturnStatus('@ret.Id', 'Refund Initiated')"><i class="bi bi-cash-coin me-2 text-warning fs-6"></i> Initiate Refund / Replacement</a></li>
                                    <li><a class="dropdown-item py-2" href="#" onclick="updateReturnStatus('@ret.Id', 'Completed')"><i class="bi bi-check-all me-2 text-success fs-6"></i> Mark Completed</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item py-2 text-danger fw-semibold" href="#" onclick="updateReturnStatus('@ret.Id', 'Rejected')"><i class="bi bi-x-circle me-2 fs-6"></i> Reject Claim</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@section Scripts {
    <script>
        function filterAdminReturns(query) {
            const term = query.toLowerCase().trim();
            document.querySelectorAll('.admin-return-card').forEach(card => {
                const text = card.getAttribute('data-search-term') || '';
                card.style.display = text.includes(term) ? '' : 'none';
            });
        }

        async function updateReturnStatus(returnId, newStatus) {
            const notes = prompt(`Enter admin notes/remarks for updating Return #${returnId} to '${newStatus}':`, '');
            if (notes === null) return;

            try {
                const response = await fetch(`/api/v1/returns/${returnId}/status`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ status: newStatus, adminNotes: notes })
                });

                const data = await response.json();
                if (response.ok && data.success) {
                    if (typeof showAuraToast === 'function') {
                        showAuraToast(data.message || `Claim #${returnId} updated to ${newStatus}`, 'success');
                    } else {
                        alert(data.message || `Claim updated to ${newStatus}`);
                    }
                    setTimeout(() => window.location.reload(), 800);
                } else {
                    alert(data.message || 'Error updating return status');
                }
            } catch (err) {
                console.error(err);
                alert('An error occurred while updating status');
            }
        }
    </script>
}
