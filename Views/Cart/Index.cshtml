@model AuraLiving.Models.CartViewModel
@{
    ViewData["Title"] = "Your Shopping Bag";
    var breadcrumbs = new List<(string Title, string Url)>
    {
        ("Shopping Bag", "")
    };
}

<div class="container py-4">
    <partial name="_Breadcrumb" model="breadcrumbs" />

    <div class="container py-4">
    <partial name="_Breadcrumb" model="breadcrumbs" />

    <div class="d-flex align-items-baseline justify-content-between mb-4 pb-2 border-bottom">
        <h1 class="h2 fw-bold mb-0">@Localizer["Shopping Cart"]</h1>
        <span class="text-muted" id="cartHeaderAppliancesCount">(@Model.Items.Sum(i => i.Quantity) appliances)</span>
    </div>


    @if (Model.Items.Any())
    {
        <div class="row g-4 g-lg-5">
            <!-- Items List -->
            <div class="col-lg-8">
                <!-- Free Shipping / White-Glove Milestone Alert -->
                <div class="alert alert-success d-flex align-items-center gap-3 rounded-3 py-3 px-4 mb-4 border-0 shadow-sm" style="background: #ecfdf5;">
                    <i class="bi bi-truck fs-3 text-success"></i>
                    <div>
                        <strong class="text-success d-block">@Localizer["Free Shipping"]</strong>
                        <small class="text-secondary">Includes free in-home unboxing, packaging removal, and certified demo setup.</small>
                    </div>
                </div>

                <div class="d-flex flex-column gap-3">
                    @foreach (var item in Model.Items)
                    {
                        <div class="p-3 p-md-4 rounded-4 bg-white border aura-cart-item-row shadow-sm" data-product-id="@item.ProductId" data-price="@item.Price">
                            <div class="row align-items-center g-3">
                                <!-- Image -->
                                <div class="col-3 col-md-2 text-center bg-light rounded-3 p-2">
                                    <img src="@item.Image" alt="@item.ProductName" class="img-fluid" style="max-height: 85px; object-fit: contain;" />
                                </div>

                                <!-- Details -->
                                <div class="col-9 col-md-5">
                                    <span class="text-uppercase fw-bold text-primary small" style="font-size: 0.7rem;">@item.Brand</span>
                                    <h5 class="fw-bold text-dark mb-1" style="font-size: 0.95rem;">
                                        <a href="/product/@item.ProductSlug" class="text-dark text-decoration-none">@Localizer[item.ProductName]</a>
                                    </h5>
                                    <div class="text-muted small mb-2">
                                        @if (!string.IsNullOrEmpty(item.SelectedCapacity))
                                        {
                                            <span>Cap: <strong>@item.SelectedCapacity</strong></span>
                                        }
                                        @if (!string.IsNullOrEmpty(item.SelectedColor))
                                        {
                                            <span class="ms-2">Color: <strong>@item.SelectedColor</strong></span>
                                        }
                                    </div>
                                    <div class="d-flex gap-3 small">
                                        <a href="#" class="text-muted text-decoration-none aura-cart-remove-btn" data-product-id="@item.ProductId"><i class="bi bi-trash3 me-1"></i> @Localizer["Cancel Order"]</a>
                                        <a href="#" class="text-muted text-decoration-none" onclick="event.preventDefault(); showAuraToast('Item saved for later!', 'dark');"><i class="bi bi-bookmark me-1"></i> @Localizer["Wishlist Saved"]</a>
                                    </div>
                                </div>

                                <!-- Stepper Quantity -->
                                <div class="col-6 col-md-2">
                                    <div class="input-group input-group-sm aura-qty-stepper">
                                        <button class="btn btn-outline-secondary aura-qty-minus" type="button">-</button>
                                        <input type="text" class="form-control text-center aura-qty-input fw-bold" value="@item.Quantity" readonly />
                                        <button class="btn btn-outline-secondary aura-qty-plus" type="button">+</button>
                                    </div>
                                </div>

                                <!-- Item Total -->
                                <div class="col-6 col-md-3 text-end">
                                    <div class="fw-bold fs-5 text-dark aura-cart-item-total">₹@item.Total.ToString("N0")</div>
                                    <small class="text-muted text-decoration-line-through">₹@((item.OriginalPrice * item.Quantity).ToString("N0"))</small>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4 pt-3">
                    <a href="/products" class="btn aura-btn-outline rounded-pill px-4">
                        <i class="bi bi-arrow-left me-1"></i> @Localizer["Shop Now"]
                    </a>
                </div>
            </div>

            <!-- Order Summary Sidebar -->
            <div class="col-lg-4">
                <div class="p-4 rounded-4 bg-white border shadow-sm sticky-top" style="top: 90px;">
                    <h5 class="fw-bold text-dark mb-3">@Localizer["Order Summary"]</h5>

                    <!-- Coupon Input -->
                    <div class="mb-4">
                        <label class="small fw-semibold text-muted mb-1">@Localizer["Coupon Code"]</label>
                        <div class="aura-coupon-pill-group">
                            <input type="text" id="couponCodeInput" class="form-control text-uppercase" placeholder="@Localizer["Coupon Code"]" value="" />
                            <button class="btn aura-btn-dark aura-coupon-pill-btn" type="button" id="applyCouponBtn">@Localizer["Apply"]</button>
                        </div>
                        <span id="couponMessage" class="text-success small mt-1 @(Model.Discount > 0 ? "d-block" : "d-none")">
                            <i class="bi bi-check-circle-fill"></i> @Localizer["Coupon applied successfully!"]
                        </span>
                    </div>

                    <!-- Price Calculation -->
                    <div class="d-flex justify-content-between mb-2 small text-secondary">
                        <span id="cartTotalItemsLabel">@Localizer["Subtotal"] (<span id="cartTotalItemsCount">@Model.Items.Sum(i => i.Quantity)</span> @Localizer["items"])</span>
                        <span class="text-dark fw-bold" id="cartSubtotal" data-subtotal="@Model.SubTotal">₹@Model.SubTotal.ToString("N0")</span>
                    </div>


                    <div class="d-flex justify-content-between mb-2 small text-success">
                        <span>@Localizer["Discount"]</span>
                        <span class="fw-bold" id="cartDiscount" data-discount="@Model.Discount">-₹@Model.Discount.ToString("N0")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 small text-secondary">
                        <span>@Localizer["Shipping"]</span>
                        <span class="text-success fw-bold">@Localizer["Free Shipping"]</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 small text-secondary">
                        <span>@Localizer["Tax"]</span>
                        <span class="text-success fw-bold">@Localizer["Free Shipping"]</span>
                    </div>

                    <hr class="my-3" />

                    <div class="d-flex justify-content-between align-items-baseline mb-4">
                        <span class="fw-bold text-dark fs-5">@Localizer["Total"]</span>
                        <span class="display-6 fw-bold text-dark" id="cartGrandTotal">₹@Model.GrandTotal.ToString("N0")</span>
                    </div>

                    <a href="/checkout" class="btn aura-btn-primary w-100 py-3 fw-bold rounded-pill text-center d-block mb-3 shadow-sm">
                        @Localizer["Checkout"] <i class="bi bi-arrow-right ms-1"></i>
                    </a>

                    <div class="text-center text-muted small">
                        <i class="bi bi-shield-lock-fill text-success me-1"></i> @Localizer["Protected Payments:"]
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5 bg-white rounded-4 border p-5">
            <i class="bi bi-bag-x text-muted opacity-50" style="font-size: 4rem;"></i>
            <h3 class="fw-bold mt-3">@Localizer["Cart"]</h3>
            <p class="text-muted small mb-4">Discover our curated catalog of smart refrigerators, silent washing machines, and OLED televisions.</p>
            <a href="/products" class="btn aura-btn-primary px-4 py-2 rounded-pill">
                @Localizer["Shop Now"]
            </a>
        </div>
    }
</div>
