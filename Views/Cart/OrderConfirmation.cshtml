@model AuraLiving.Models.OrderViewModel
@{
    ViewData["Title"] = $"Order Placed - {Model.Id}";
}

<div class="container py-5">
    <!-- Success Celebration Header -->
    <div class="text-center mb-5">
        <div class="d-inline-flex align-items-center justify-content-center bg-success text-white rounded-circle mb-3 shadow" style="width: 72px; height: 72px;">
            <i class="bi bi-check-lg display-5"></i>
        </div>
        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 mb-2 d-inline-block">Order Successfully Confirmed</span>
        <h1 class="fw-bold text-dark mb-2">Thank You for Choosing Indoria</h1>
        <p class="text-secondary mb-0">
            Order <strong>#@Model.Id</strong> has been placed. An invoice and live GPS dispatch tracker have been dispatched to your email.
        </p>
    </div>

    <div class="row g-4 g-lg-5">
        <!-- Delivery Tracking & Shipment Timeline -->
        <div class="col-lg-7">
            <div class="p-4 p-md-5 rounded-4 bg-white border shadow-sm mb-4">
                <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                    <div>
                        <span class="text-uppercase fw-bold text-muted small">Estimated Delivery</span>
                        <h4 class="fw-bold text-primary mb-0">@Model.EstimatedDelivery</h4>
                    </div>
                    <span class="badge bg-primary px-3 py-2 fs-6">Status: @Model.Status</span>
                </div>

                <!-- Shipment Tracking Timeline -->
                <h6 class="fw-bold text-dark mb-4">White-Glove Delivery &amp; Setup Progress:</h6>
                <div class="aura-order-timeline">
                    @foreach (var step in Model.Timeline)
                    {
                        <div class="aura-timeline-step @(step.IsCompleted ? "completed" : "") @(step.IsCurrent ? "current" : "")">
                            <div class="aura-timeline-dot"></div>
                            <div class="fw-bold text-dark">@step.Title</div>
                            <p class="text-muted small mb-1">@step.Description</p>
                            <small class="text-secondary fw-semibold">@step.Timestamp</small>
                        </div>
                    }
                </div>
            </div>

            <!-- Delivery Address Card -->
            <div class="p-4 rounded-4 bg-white border shadow-sm">
                <h5 class="fw-bold text-dark mb-3"><i class="bi bi-geo-alt text-primary me-2"></i> Destination Address</h5>
                <div class="text-secondary small">
                    <strong class="text-dark">@Model.ShippingAddress.FullName</strong> (@Model.ShippingAddress.Type)<br />
                    @Model.ShippingAddress.AddressLine1, @Model.ShippingAddress.AddressLine2<br />
                    @Model.ShippingAddress.City, @Model.ShippingAddress.State - <strong>@Model.ShippingAddress.Pincode</strong><br />
                    <span class="text-muted mt-1 d-block"><i class="bi bi-telephone me-1"></i> Contact: @Model.ShippingAddress.Phone</span>
                </div>
            </div>
        </div>

        <!-- Order Summary & Items -->
        <div class="col-lg-5">
            <div class="p-4 rounded-4 bg-white border shadow-sm">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark mb-0">Order Summary</h5>
                    <button class="btn btn-outline-secondary btn-sm" onclick="window.print();">
                        <i class="bi bi-printer me-1"></i> Print Invoice
                    </button>
                </div>

                <!-- Ordered Items -->
                <div class="d-flex flex-column gap-3 mb-4">
                    @foreach (var itm in Model.Items)
                    {
                        <div class="d-flex align-items-center justify-content-between p-2 rounded-3 bg-light">
                            <div class="d-flex align-items-center gap-3">
                                <img src="@itm.Image" alt="@itm.ProductName" style="width: 48px; height: 48px; object-fit: contain;" />
                                <div>
                                    <div class="fw-bold text-dark small text-truncate" style="max-width: 200px;">@itm.ProductName</div>
                                    <small class="text-muted">Qty: @itm.Quantity • @itm.SelectedCapacity</small>
                                </div>
                            </div>
                            <div class="fw-bold text-dark small">₹@itm.Total.ToString("N0")</div>
                        </div>
                    }
                </div>

                <!-- Totals -->
                <div class="d-flex justify-content-between mb-2 small text-secondary">
                    <span>Items Subtotal</span>
                    <span class="text-dark fw-bold">₹@Model.SubTotal.ToString("N0")</span>
                </div>
                <div class="d-flex justify-content-between mb-2 small text-success">
                    <span>Discount Applied</span>
                    <span class="fw-bold">-₹@Model.Discount.ToString("N0")</span>
                </div>
                <div class="d-flex justify-content-between mb-2 small text-secondary">
                    <span>Express White-Glove Logistics</span>
                    <span class="text-success fw-bold">FREE</span>
                </div>
                <div class="d-flex justify-content-between mb-3 small text-secondary">
                    <span>Payment Method</span>
                    <span class="text-dark fw-semibold">@Model.PaymentMethod</span>
                </div>
                <hr />
                <div class="d-flex justify-content-between align-items-baseline mb-4">
                    <span class="fw-bold fs-5 text-dark">Amount Paid</span>
                    <span class="display-6 fw-bold text-dark">₹@Model.GrandTotal.ToString("N0")</span>
                </div>

                <div class="d-grid gap-2">
                    <a href="/account/orders/@Model.Id" class="btn aura-btn-primary py-2 fw-bold text-center">
                        <i class="bi bi-box-seam me-1"></i> Track in Account Dashboard
                    </a>
                    <a href="/products" class="btn aura-btn-outline py-2 text-center">
                        Continue Shopping
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
