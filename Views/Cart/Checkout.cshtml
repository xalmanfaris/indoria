@model AuraLiving.Models.CheckoutViewModel
@{
    ViewData["Title"] = "Secure Checkout";
}

<div class="container py-4">
    <!-- Floating Glass Segmented Stepper Progress Track -->
    <div class="aura-stepper-wrap mb-5">
        <div class="aura-stepper">
            <div class="aura-stepper-progress-line"></div>
            
            <div class="aura-step-item active" data-step="1" role="button" title="@Localizer["Shipping Address"]">
                <div class="aura-step-circle">
                    <span class="aura-step-circle-icon">1</span>
                </div>
                <div class="aura-step-label-group">
                    <span class="aura-step-sub">01</span>
                    <span class="aura-step-title">@Localizer["Shipping Address"]</span>
                </div>
            </div>

            <div class="aura-step-item" data-step="2" role="button" title="@Localizer["Shipping"]">
                <div class="aura-step-circle">
                    <span class="aura-step-circle-icon">2</span>
                </div>
                <div class="aura-step-label-group">
                    <span class="aura-step-sub">02</span>
                    <span class="aura-step-title">@Localizer["Shipping"]</span>
                </div>
            </div>

            <div class="aura-step-item" data-step="3" role="button" title="@Localizer["Payment Method"]">
                <div class="aura-step-circle">
                    <span class="aura-step-circle-icon">3</span>
                </div>
                <div class="aura-step-label-group">
                    <span class="aura-step-sub">03</span>
                    <span class="aura-step-title">@Localizer["Payment Method"]</span>
                </div>
            </div>

            <div class="aura-step-item" data-step="4" role="button" title="@Localizer["Order Summary"]">
                <div class="aura-step-circle">
                    <span class="aura-step-circle-icon">4</span>
                </div>
                <div class="aura-step-label-group">
                    <span class="aura-step-sub">04</span>
                    <span class="aura-step-title">@Localizer["Order Summary"]</span>
                </div>
            </div>
        </div>
    </div>

    <form method="post" action="/Cart/PlaceOrder" id="checkoutForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="selectedAddressId" id="selectedAddressIdInput" value="@(Model.Address?.Id ?? "")" />
        <input type="hidden" name="shippingSpeed" id="shippingSpeedInput" value="express" />
        <input type="hidden" name="paymentMethod" id="paymentMethodInput" value="UPI Transfer (Google Pay)" />

    <div class="row g-4 g-lg-5 mb-5">
        <!-- Main Interactive Multi-Step Pane -->
        <div class="col-lg-8">
            <!-- STEP 1: Delivery Address Selection -->
            <div class="aura-checkout-step-pane" data-step="1">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <span class="text-uppercase fw-bold text-primary small letter-spacing-1">Step 1 of 4</span>
                        <h3 class="fw-bold text-dark mb-0">Select Delivery Address</h3>
                    </div>
                    <button class="btn aura-btn-outline btn-sm rounded-pill px-3 py-2 fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#newAddressCollapse">
                        <i class="bi bi-plus-lg me-1"></i> Add New Address
                    </button>
                </div>

                <!-- Saved Address Glass Cards -->
                <div class="row g-3 mb-4">
                    @foreach (var addr in Model.SavedAddresses)
                    {
                        <div class="col-md-6">
                            <div class="aura-address-card @(addr.IsDefault ? "active" : "")" onclick="document.getElementById('addr_@addr.Id').click()">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="selectedAddress" id="addr_@addr.Id" value="@addr.Id" @(addr.IsDefault ? "checked" : "") onchange="document.getElementById('selectedAddressIdInput').value = this.value" />
                                    <label class="form-check-label fw-bold text-dark d-inline-block ms-1" for="addr_@addr.Id">
                                        @addr.FullName <span class="badge bg-dark text-white rounded-pill px-2 py-1 ms-1" style="font-size: 0.7rem;">@addr.Type</span>
                                    </label>
                                </div>
                                <div class="small text-secondary ps-4">
                                    <div>@addr.AddressLine1, @addr.AddressLine2</div>
                                    <div>@addr.City, @addr.State - <strong class="text-dark">@addr.Pincode</strong></div>
                                    <div class="mt-2 text-dark font-monospace"><i class="bi bi-telephone-fill me-1 text-primary"></i> @addr.Phone</div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Collapsible Form for Adding New Address -->
                <div class="collapse mb-4" id="newAddressCollapse">
                    <div class="p-4 rounded-4 bg-light border">
                        <h6 class="fw-bold text-dark mb-3"><i class="bi bi-geo-alt-fill text-primary me-2"></i> Enter New Delivery Address</h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="small fw-semibold text-muted mb-1">Full Name</label>
                                <input type="text" class="form-control rounded-3" placeholder="e.g. Arjun Mehta" />
                            </div>
                            <div class="col-md-6">
                                <label class="small fw-semibold text-muted mb-1">Mobile Phone Number</label>
                                <input type="text" class="form-control rounded-3" placeholder="e.g. 98201 45890" />
                            </div>
                            <div class="col-12">
                                <label class="small fw-semibold text-muted mb-1">Street Address / Flat / Building</label>
                                <input type="text" class="form-control rounded-3" placeholder="Apartment / Building details" />
                            </div>
                            <div class="col-md-4">
                                <label class="small fw-semibold text-muted mb-1">City</label>
                                <input type="text" class="form-control rounded-3" placeholder="Mumbai" />
                            </div>
                            <div class="col-md-4">
                                <label class="small fw-semibold text-muted mb-1">State</label>
                                <input type="text" class="form-control rounded-3" placeholder="Maharashtra" />
                            </div>
                            <div class="col-md-4">
                                <label class="small fw-semibold text-muted mb-1">PIN Code</label>
                                <input type="text" class="form-control rounded-3" placeholder="400001" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end">
                    <button type="button" class="btn aura-btn-primary rounded-pill px-5 py-3 fw-bold shadow-sm" onclick="goToCheckoutStep(2)">
                        Continue to Delivery Options <i class="bi bi-arrow-right ms-2"></i>
                    </button>
                </div>
            </div>

            <!-- STEP 2: Delivery Speed & Service Option -->
            <div class="aura-checkout-step-pane d-none" data-step="2">
                <div class="mb-4">
                    <span class="text-uppercase fw-bold text-primary small letter-spacing-1">Step 2 of 4</span>
                    <h3 class="fw-bold text-dark mb-0">Delivery &amp; White-Glove Setup Method</h3>
                </div>

                <div class="d-flex flex-column gap-3 mb-4">
                    <div class="aura-shipping-option active" onclick="document.getElementById('shippingExpress').click()">
                        <div class="d-flex align-items-center gap-3">
                            <input class="form-check-input mt-0" type="radio" name="shippingSpeed" id="shippingExpress" value="express" checked />
                            <div>
                                <strong class="text-dark fs-6 d-block mb-1">White-Glove Express Delivery &amp; Demo (Recommended)</strong>
                                <span class="text-muted small">Estimated: Tomorrow by 2:00 PM • Includes unboxing, leveling &amp; installation</span>
                            </div>
                        </div>
                        <span class="badge bg-success rounded-pill px-3 py-2 fs-6 fw-bold">FREE</span>
                    </div>

                    <div class="aura-shipping-option" onclick="document.getElementById('shippingScheduled').click()">
                        <div class="d-flex align-items-center gap-3">
                            <input class="form-check-input mt-0" type="radio" name="shippingSpeed" id="shippingScheduled" value="scheduled" />
                            <div>
                                <strong class="text-dark fs-6 d-block mb-1">Scheduled Weekend Delivery Slot</strong>
                                <span class="text-muted small">Choose your preferred Saturday or Sunday time slot for delivery</span>
                            </div>
                        </div>
                        <span class="badge bg-light text-dark border rounded-pill px-3 py-2 fw-bold">FREE</span>
                    </div>
                </div>

                <div class="d-flex justify-content-between">
                    <button type="button" class="btn aura-btn-outline rounded-pill px-4 py-3 fw-bold" onclick="goToCheckoutStep(1)">
                        <i class="bi bi-arrow-left me-1"></i> Back
                    </button>
                    <button type="button" class="btn aura-btn-primary rounded-pill px-5 py-3 fw-bold shadow-sm" onclick="goToCheckoutStep(3)">
                        Continue to Payment <i class="bi bi-arrow-right ms-2"></i>
                    </button>
                </div>
            </div>

            <!-- STEP 3: Payment Method Options -->
            <div class="aura-checkout-step-pane d-none" data-step="3">
                <div class="mb-4">
                    <span class="text-uppercase fw-bold text-primary small letter-spacing-1">Step 3 of 4</span>
                    <h3 class="fw-bold text-dark mb-0">Select Payment Option</h3>
                </div>

                <div class="accordion aura-payment-accordion mb-4" id="paymentAccordion">
                    <!-- UPI Payment -->
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="headingUPI">
                            <button class="accordion-button fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseUPI" aria-expanded="true">
                                <i class="bi bi-qr-code-scan text-success me-3 fs-4"></i> UPI Instant Transfer (GPay, PhonePe, Paytm, BHIM)
                            </button>
                        </h2>
                        <div id="collapseUPI" class="accordion-collapse collapse show" data-bs-parent="#paymentAccordion">
                            <div class="accordion-body">
                                <p class="small text-muted mb-3">Scan QR code instantly or enter your Virtual Payment Address (VPA):</p>
                                <div class="aura-coupon-pill-group mb-2" style="max-width: 420px;">
                                    <input type="text" class="form-control" placeholder="username@okhdfcbank" value="arjun.mehta@oksbi" />
                                    <button class="btn aura-btn-primary aura-coupon-pill-btn" type="button">Verify VPA</button>
                                </div>
                                <small class="text-success fw-bold d-block"><i class="bi bi-check-circle-fill me-1"></i> Verified VPA: Arjun Mehta</small>
                            </div>
                        </div>
                    </div>

                    <!-- Credit / Debit Card -->
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="headingCard">
                            <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCard">
                                <i class="bi bi-credit-card-2-front text-primary me-3 fs-4"></i> Credit or Debit Card (Visa, MasterCard, RuPay)
                            </button>
                        </h2>
                        <div id="collapseCard" class="accordion-collapse collapse" data-bs-parent="#paymentAccordion">
                            <div class="accordion-body">
                                <div class="row g-3" style="max-width: 500px;">
                                    <div class="col-12">
                                        <label class="small text-muted fw-semibold mb-1">Card Number</label>
                                        <input type="text" class="form-control rounded-3" placeholder="•••• •••• •••• 4242" value="4532 •••• •••• 9812" />
                                    </div>
                                    <div class="col-6">
                                        <label class="small text-muted fw-semibold mb-1">Expiry (MM/YY)</label>
                                        <input type="text" class="form-control rounded-3" placeholder="12/28" value="08/29" />
                                    </div>
                                    <div class="col-6">
                                        <label class="small text-muted fw-semibold mb-1">CVV Security Code</label>
                                        <input type="password" class="form-control rounded-3" placeholder="•••" value="789" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Net Banking -->
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="headingNet">
                            <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseNet">
                                <i class="bi bi-bank text-primary me-3 fs-4"></i> Net Banking (HDFC, ICICI, SBI, Axis, Kotak)
                            </button>
                        </h2>
                        <div id="collapseNet" class="accordion-collapse collapse" data-bs-parent="#paymentAccordion">
                            <div class="accordion-body">
                                <div class="row row-cols-2 row-cols-sm-3 g-2" style="max-width: 440px;">
                                    <div class="col"><button class="btn aura-variant-pill w-100 justify-content-center">HDFC Bank</button></div>
                                    <div class="col"><button class="btn aura-variant-pill w-100 justify-content-center">ICICI Bank</button></div>
                                    <div class="col"><button class="btn aura-variant-pill w-100 justify-content-center">SBI</button></div>
                                    <div class="col"><button class="btn aura-variant-pill w-100 justify-content-center">Axis Bank</button></div>
                                    <div class="col"><button class="btn aura-variant-pill w-100 justify-content-center">Kotak</button></div>
                                    <div class="col"><button class="btn aura-variant-pill w-100 justify-content-center">Other</button></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Cash on Delivery -->
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="headingCOD">
                            <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCOD">
                                <i class="bi bi-cash-stack text-success me-3 fs-4"></i> Cash on Delivery / Pay on Installation
                            </button>
                        </h2>
                        <div id="collapseCOD" class="accordion-collapse collapse" data-bs-parent="#paymentAccordion">
                            <div class="accordion-body">
                                <p class="small text-muted mb-0">Pay via Cash, UPI, or Card upon appliance delivery and verification by our certified installation technicians.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between">
                    <button type="button" class="btn aura-btn-outline rounded-pill px-4 py-3 fw-bold" onclick="goToCheckoutStep(2)">
                        <i class="bi bi-arrow-left me-1"></i> Back
                    </button>
                    <button type="button" class="btn aura-btn-primary rounded-pill px-5 py-3 fw-bold shadow-sm" onclick="goToCheckoutStep(4)">
                        Review Order <i class="bi bi-arrow-right ms-2"></i>
                    </button>
                </div>
            </div>

            <!-- STEP 4: Review Order & Place Order -->
            <div class="aura-checkout-step-pane d-none" data-step="4">
                <div class="mb-4">
                    <span class="text-uppercase fw-bold text-primary small letter-spacing-1">Step 4 of 4</span>
                    <h3 class="fw-bold text-dark mb-0">Review &amp; Place Your Order</h3>
                </div>

                <!-- Review Details Summary Cards -->
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="aura-trust-card text-start p-3 h-100">
                            <h6 class="fw-bold text-dark mb-2"><i class="bi bi-geo-alt-fill text-primary me-2"></i> Delivery Address:</h6>
                            <div class="small text-secondary">
                                <strong class="text-dark d-block mb-1">@(User.Identity?.Name ?? "Patron") (Home)</strong>
                                Penthouse 14B, Horizon Royale Towers, Sector 18, Mumbai 400705<br />
                                Phone: +91 98201 45890
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="aura-trust-card text-start p-3 h-100">
                            <h6 class="fw-bold text-dark mb-2"><i class="bi bi-shield-check text-success me-2"></i> Payment &amp; Logistics:</h6>
                            <div class="small text-secondary">
                                <strong class="text-dark d-block mb-1">UPI Transfer (Google Pay)</strong>
                                Method: White-Glove Express Delivery (Free)
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Order Items Breakdown -->
                <div class="mb-4">
                    <h6 class="fw-bold text-dark mb-3">Items in This Order (@Model.Cart.Items.Count):</h6>
                    <div class="d-flex flex-column gap-2">
                        @foreach (var itm in Model.Cart.Items)
                        {
                            <div class="d-flex align-items-center justify-content-between p-3 rounded-4 bg-light">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@itm.Image" alt="@itm.ProductName" class="rounded-3" style="width: 54px; height: 54px; object-fit: contain;" referrerpolicy="no-referrer" onerror="this.onerror=null;this.src='/images/homixa_hero_appliances.jpg';" />
                                    <div>
                                        <div class="fw-bold text-dark small">@itm.ProductName</div>
                                        <small class="text-muted">Qty: @itm.Quantity • @itm.SelectedCapacity • @itm.SelectedColor</small>
                                    </div>
                                </div>
                                <div class="fw-bold text-dark fs-6">₹@itm.Total.ToString("N0")</div>
                            </div>
                        }
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <button type="button" class="btn aura-btn-outline rounded-pill px-4 py-3 fw-bold" onclick="goToCheckoutStep(3)">
                        <i class="bi bi-arrow-left me-1"></i> Back
                    </button>
                    <button type="submit" class="btn aura-btn-pdp-buy px-5 py-3 fw-bold text-center shadow-lg">
                        Place Order &amp; Confirm (₹@Model.Cart.GrandTotal.ToString("N0")) <i class="bi bi-check2-circle fs-5 ms-1"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Sticky Order Summary Sidebar -->
        <div class="col-lg-4">
            <div class="aura-checkout-sidebar">
                <h5 class="fw-bold text-dark mb-3">Order Summary</h5>

                <div class="d-flex justify-content-between mb-2 small text-secondary">
                    <span>Subtotal (@Model.Cart.Items.Count items)</span>
                    <span class="text-dark fw-bold" id="cartSubtotal" data-subtotal="@Model.Cart.SubTotal">₹@Model.Cart.SubTotal.ToString("N0")</span>
                </div>

                <div class="d-flex justify-content-between mb-2 small text-success">
                    <span>Voucher Discount</span>
                    <span class="fw-bold" id="cartDiscount" data-discount="@Model.Cart.Discount">-₹@Model.Cart.Discount.ToString("N0")</span>
                </div>
                <div class="d-flex justify-content-between mb-2 small text-secondary">
                    <span>Express White-Glove Shipping</span>
                    <span class="text-success fw-bold">FREE</span>
                </div>
                <div class="d-flex justify-content-between mb-3 small text-secondary">
                    <span>Certified Brand Installation</span>
                    <span class="text-success fw-bold">FREE</span>
                </div>

                <!-- Interactive Coupon Code Input -->
                <div class="mb-4">
                    <div class="aura-coupon-pill-group">
                        <input type="text" id="couponCodeInput" class="form-control text-uppercase" placeholder="Voucher Code" value="" />
                        <button class="btn aura-btn-dark aura-coupon-pill-btn" type="button" id="applyCouponBtn">Apply</button>
                    </div>
                    <small id="couponMessage" class="text-success small mt-1 d-none fw-semibold"></small>
                </div>


                <hr class="my-3 opacity-10" />

                <div class="d-flex justify-content-between align-items-baseline mb-4">
                    <span class="fw-bold fs-5 text-dark">Total Amount</span>
                    <span class="display-6 fw-bold text-dark" id="cartGrandTotal">₹@Model.Cart.GrandTotal.ToString("N0")</span>
                </div>

                <!-- 256-Bit SSL Encryption Protection Badge -->
                <div class="p-3 rounded-4 bg-light border-0 small text-secondary d-flex align-items-center gap-3">
                    <i class="bi bi-shield-lock-fill text-success fs-3 flex-shrink-0"></i>
                    <div>
                        <strong class="text-dark d-block mb-1">256-Bit SSL Encrypted</strong>
                        <span>Your transaction and bank details are fully encrypted and protected.</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    </form>
</div>
