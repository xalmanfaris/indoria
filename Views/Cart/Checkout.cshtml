@model AuraLiving.Models.CheckoutViewModel
@{
    ViewData["Title"] = "Secure Checkout";
}

<div class="container py-4">
    <!-- Stepper Progress Indicator -->
    <div class="aura-stepper mb-5">
        <div class="aura-step-item active" data-step="1">
            <div class="aura-step-circle">1</div>
            <div class="aura-step-label">Delivery Address</div>
        </div>
        <div class="aura-step-item" data-step="2">
            <div class="aura-step-circle">2</div>
            <div class="aura-step-label">Delivery Speed</div>
        </div>
        <div class="aura-step-item" data-step="3">
            <div class="aura-step-circle">3</div>
            <div class="aura-step-label">Payment Method</div>
        </div>
        <div class="aura-step-item" data-step="4">
            <div class="aura-step-circle">4</div>
            <div class="aura-step-label">Order Review</div>
        </div>
    </div>

    <div class="row g-4 g-lg-5">
        <!-- Main Interactive Multi-Step Pane -->
        <div class="col-lg-8">
            <!-- STEP 1: Delivery Address -->
            <div class="aura-checkout-step-pane p-4 p-md-5 rounded-4 bg-white border shadow-sm" data-step="1">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="fw-bold text-dark mb-0">1. Select Delivery Address</h4>
                    <button class="btn btn-outline-primary btn-sm rounded-pill" type="button" data-bs-toggle="collapse" data-bs-target="#newAddressCollapse">
                        <i class="bi bi-plus-lg me-1"></i> Add New Address
                    </button>
                </div>

                <!-- Saved Addresses Cards -->
                <div class="row g-3 mb-4">
                    @foreach (var addr in Model.SavedAddresses)
                    {
                        <div class="col-md-6">
                            <div class="p-3 rounded-3 border @(addr.IsDefault ? "border-primary bg-primary-subtle bg-opacity-10" : "bg-light") position-relative">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="selectedAddress" id="addr_@addr.Id" @(addr.IsDefault ? "checked" : "") />
                                    <label class="form-check-label fw-bold text-dark d-block" for="addr_@addr.Id">
                                        @addr.FullName <span class="badge bg-secondary text-light ms-1">@addr.Type</span>
                                    </label>
                                </div>
                                <div class="small text-secondary mt-2 ms-4">
                                    <div>@addr.AddressLine1, @addr.AddressLine2</div>
                                    <div>@addr.City, @addr.State - <strong>@addr.Pincode</strong></div>
                                    <div class="mt-1"><i class="bi bi-telephone me-1"></i> @addr.Phone</div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Collapsible New Address Form -->
                <div class="collapse mb-4" id="newAddressCollapse">
                    <div class="p-4 rounded-3 border bg-light">
                        <h6 class="fw-bold mb-3">Enter New Delivery Address</h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="small fw-semibold text-muted">Full Name</label>
                                <input type="text" class="form-control form-control-sm" placeholder="e.g. Arjun Mehta" />
                            </div>
                            <div class="col-md-6">
                                <label class="small fw-semibold text-muted">Phone Number</label>
                                <input type="text" class="form-control form-control-sm" placeholder="e.g. 98201 45890" />
                            </div>
                            <div class="col-12">
                                <label class="small fw-semibold text-muted">Street / Flat / House No.</label>
                                <input type="text" class="form-control form-control-sm" placeholder="Apartment / Building details" />
                            </div>
                            <div class="col-md-4">
                                <label class="small fw-semibold text-muted">City</label>
                                <input type="text" class="form-control form-control-sm" placeholder="Mumbai" />
                            </div>
                            <div class="col-md-4">
                                <label class="small fw-semibold text-muted">State</label>
                                <input type="text" class="form-control form-control-sm" placeholder="Maharashtra" />
                            </div>
                            <div class="col-md-4">
                                <label class="small fw-semibold text-muted">PIN Code</label>
                                <input type="text" class="form-control form-control-sm" placeholder="400001" />
                            </div>
                        </div>
                    </div>
                </div>

                <button type="button" class="btn aura-btn-primary rounded-pill px-4 py-2 fw-bold" onclick="goToCheckoutStep(2)">
                    Continue to Delivery Options <i class="bi bi-arrow-right ms-1"></i>
                </button>
            </div>

            <!-- STEP 2: Delivery Speed & Service -->
            <div class="aura-checkout-step-pane p-4 p-md-5 rounded-4 bg-white border shadow-sm d-none" data-step="2">
                <h4 class="fw-bold text-dark mb-4">2. Choose Delivery &amp; Setup Method</h4>

                <div class="d-flex flex-column gap-3 mb-4">
                    <label class="p-3 rounded-3 border d-flex align-items-center justify-content-between cursor-pointer bg-light">
                        <div class="d-flex align-items-center gap-3">
                            <input class="form-check-input mt-0" type="radio" name="shippingSpeed" value="express" checked />
                            <div>
                                <strong class="text-dark d-block">White-Glove Express Delivery (Recommended)</strong>
                                <small class="text-muted">Estimated: Tomorrow by 2:00 PM • Includes free unboxing, leveling &amp; installation</small>
                            </div>
                        </div>
                        <span class="badge bg-success fw-bold">FREE</span>
                    </label>

                    <label class="p-3 rounded-3 border d-flex align-items-center justify-content-between cursor-pointer">
                        <div class="d-flex align-items-center gap-3">
                            <input class="form-check-input mt-0" type="radio" name="shippingSpeed" value="scheduled" />
                            <div>
                                <strong class="text-dark d-block">Scheduled Weekend Delivery</strong>
                                <small class="text-muted">Choose your preferred Saturday or Sunday time slot</small>
                            </div>
                        </div>
                        <span class="badge bg-light text-dark border">FREE</span>
                    </label>
                </div>

                <div class="d-flex gap-2">
                    <button type="button" class="btn aura-btn-outline rounded-pill px-4" onclick="goToCheckoutStep(1)">
                        <i class="bi bi-arrow-left me-1"></i> Back
                    </button>
                    <button type="button" class="btn aura-btn-primary rounded-pill px-4 py-2 fw-bold" onclick="goToCheckoutStep(3)">
                        Continue to Payment <i class="bi bi-arrow-right ms-1"></i>
                    </button>
                </div>
            </div>

            <!-- STEP 3: Payment Options -->
            <div class="aura-checkout-step-pane p-4 p-md-5 rounded-4 bg-white border shadow-sm d-none" data-step="3">
                <h4 class="fw-bold text-dark mb-4">3. Select Payment Method</h4>

                <div class="accordion mb-4" id="paymentAccordion">
                    <!-- UPI -->
                    <div class="accordion-item border rounded-3 mb-3 overflow-hidden">
                        <h2 class="accordion-header" id="headingUPI">
                            <button class="accordion-button fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseUPI" aria-expanded="true">
                                <i class="bi bi-qr-code-scan text-primary me-2 fs-5"></i> UPI / QR Code (Google Pay, PhonePe, Paytm, BHIM)
                            </button>
                        </h2>
                        <div id="collapseUPI" class="accordion-collapse collapse show" data-bs-parent="#paymentAccordion">
                            <div class="accordion-body bg-light">
                                <p class="small text-muted mb-3">Scan QR code instantly or enter your Virtual Payment Address (VPA):</p>
                                <div class="input-group input-group-sm mb-2" style="max-width: 360px;">
                                    <input type="text" class="form-control" placeholder="username@okhdfcbank" value="arjun.mehta@oksbi" />
                                    <button class="btn btn-outline-primary" type="button">Verify VPA</button>
                                </div>
                                <small class="text-success"><i class="bi bi-check-circle-fill"></i> Verified VPA: Arjun Mehta</small>
                            </div>
                        </div>
                    </div>

                    <!-- Credit / Debit Card -->
                    <div class="accordion-item border rounded-3 mb-3 overflow-hidden">
                        <h2 class="accordion-header" id="headingCard">
                            <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCard">
                                <i class="bi bi-credit-card text-primary me-2 fs-5"></i> Credit or Debit Card (Visa, MasterCard, RuPay)
                            </button>
                        </h2>
                        <div id="collapseCard" class="accordion-collapse collapse" data-bs-parent="#paymentAccordion">
                            <div class="accordion-body bg-light">
                                <div class="row g-3" style="max-width: 480px;">
                                    <div class="col-12">
                                        <label class="small text-muted fw-semibold">Card Number</label>
                                        <input type="text" class="form-control form-control-sm" placeholder="•••• •••• •••• 4242" value="4532 •••• •••• 9812" />
                                    </div>
                                    <div class="col-6">
                                        <label class="small text-muted fw-semibold">Valid Thru (MM/YY)</label>
                                        <input type="text" class="form-control form-control-sm" placeholder="12/28" value="08/29" />
                                    </div>
                                    <div class="col-6">
                                        <label class="small text-muted fw-semibold">CVV</label>
                                        <input type="password" class="form-control form-control-sm" placeholder="•••" value="789" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Net Banking -->
                    <div class="accordion-item border rounded-3 mb-3 overflow-hidden">
                        <h2 class="accordion-header" id="headingNet">
                            <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseNet">
                                <i class="bi bi-bank text-primary me-2 fs-5"></i> Net Banking (HDFC, ICICI, SBI, Axis, Kotak)
                            </button>
                        </h2>
                        <div id="collapseNet" class="accordion-collapse collapse" data-bs-parent="#paymentAccordion">
                            <div class="accordion-body bg-light">
                                <div class="row row-cols-3 g-2" style="max-width: 400px;">
                                    <div class="col"><button class="btn btn-outline-secondary w-100 btn-sm">HDFC Bank</button></div>
                                    <div class="col"><button class="btn btn-outline-secondary w-100 btn-sm">ICICI Bank</button></div>
                                    <div class="col"><button class="btn btn-outline-secondary w-100 btn-sm">SBI</button></div>
                                    <div class="col"><button class="btn btn-outline-secondary w-100 btn-sm">Axis Bank</button></div>
                                    <div class="col"><button class="btn btn-outline-secondary w-100 btn-sm">Kotak</button></div>
                                    <div class="col"><button class="btn btn-outline-secondary w-100 btn-sm">Other</button></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Cash on Delivery -->
                    <div class="accordion-item border rounded-3 overflow-hidden">
                        <h2 class="accordion-header" id="headingCOD">
                            <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCOD">
                                <i class="bi bi-cash-stack text-primary me-2 fs-5"></i> Cash on Delivery / Pay on Installation
                            </button>
                        </h2>
                        <div id="collapseCOD" class="accordion-collapse collapse" data-bs-parent="#paymentAccordion">
                            <div class="accordion-body bg-light">
                                <p class="small text-muted mb-0">Pay with Cash, UPI, or Card upon appliance delivery and verification by the white-glove team.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="button" class="btn aura-btn-outline rounded-pill px-4" onclick="goToCheckoutStep(2)">
                        <i class="bi bi-arrow-left me-1"></i> Back
                    </button>
                    <button type="button" class="btn aura-btn-primary rounded-pill px-4 py-2 fw-bold" onclick="goToCheckoutStep(4)">
                        Review Order <i class="bi bi-arrow-right ms-1"></i>
                    </button>
                </div>
            </div>

            <!-- STEP 4: Review & Place Order -->
            <div class="aura-checkout-step-pane p-4 p-md-5 rounded-4 bg-white border shadow-sm d-none" data-step="4">
                <h4 class="fw-bold text-dark mb-4">4. Review &amp; Place Your Order</h4>

                <div class="p-3 bg-light rounded-3 mb-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <h6 class="fw-bold text-dark small mb-1">Delivering To:</h6>
                            <div class="small text-secondary">
                                Arjun Mehta (Home)<br />
                                Penthouse 14B, Horizon Royale Towers, Sector 18, Mumbai 400705<br />
                                Phone: +91 98201 45890
                            </div>
                        </div>
                        <div class="col-md-6">
                            <h6 class="fw-bold text-dark small mb-1">Payment Method:</h6>
                            <div class="small text-secondary">
                                UPI (Google Pay - arjun.mehta@oksbi)<br />
                                Delivery Method: White-Glove Express Delivery (Free)
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <h6 class="fw-bold text-dark mb-3">Items in This Order (@Model.Cart.Items.Count):</h6>
                    <div class="d-flex flex-column gap-2">
                        @foreach (var itm in Model.Cart.Items)
                        {
                            <div class="d-flex align-items-center justify-content-between p-2 border-bottom">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@itm.Image" alt="@itm.ProductName" style="width: 50px; height: 50px; object-fit: contain;" />
                                    <div>
                                        <div class="fw-bold text-dark small">@itm.ProductName</div>
                                        <small class="text-muted">Qty: @itm.Quantity • @itm.SelectedCapacity</small>
                                    </div>
                                </div>
                                <div class="fw-bold text-dark">₹@itm.Total.ToString("N0")</div>
                            </div>
                        }
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="button" class="btn aura-btn-outline rounded-pill px-4" onclick="goToCheckoutStep(3)">
                        <i class="bi bi-arrow-left me-1"></i> Back
                    </button>
                    <a href="/order-confirmation/AURA-98214" class="btn aura-btn-primary rounded-pill px-5 py-3 fw-bold flex-grow-1 text-center shadow">
                        Place Order &amp; Confirm (₹@Model.Cart.GrandTotal.ToString("N0")) <i class="bi bi-check2-circle ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Sticky Summary Sidebar -->
        <div class="col-lg-4">
            <div class="p-4 rounded-4 bg-white border shadow-sm sticky-top" style="top: 90px;">
                <h5 class="fw-bold text-dark mb-3">Cart Breakdown</h5>
                <div class="d-flex justify-content-between mb-2 small text-secondary">
                    <span>Subtotal (@Model.Cart.Items.Count items)</span>
                    <span class="text-dark fw-bold">₹@Model.Cart.SubTotal.ToString("N0")</span>
                </div>
                <div class="d-flex justify-content-between mb-2 small text-success">
                    <span>Festive Coupon (LUXE5000)</span>
                    <span class="fw-bold">-₹@Model.Cart.Discount.ToString("N0")</span>
                </div>
                <div class="d-flex justify-content-between mb-2 small text-secondary">
                    <span>Express White-Glove Shipping</span>
                    <span class="text-success fw-bold">FREE</span>
                </div>
                <div class="d-flex justify-content-between mb-3 small text-secondary">
                    <span>Certified Brand Installation</span>
                    <span class="text-success fw-bold">FREE</span>
                </div>
                <hr />
                <div class="d-flex justify-content-between align-items-baseline mb-4">
                    <span class="fw-bold fs-5 text-dark">Total Amount</span>
                    <span class="display-6 fw-bold text-dark">₹@Model.Cart.GrandTotal.ToString("N0")</span>
                </div>
                <div class="p-3 bg-light rounded-3 small text-muted">
                    <i class="bi bi-shield-lock-fill text-success me-1"></i> Your transaction is protected with 256-bit bank grade encryption.
                </div>
            </div>
        </div>
    </div>
</div>
