@model List<(string Title, string Url)>

@if (Model != null && Model.Any())
{
    <nav aria-label="breadcrumb" class="py-3">
        <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item">
                <a href="/" class="text-decoration-none text-muted"><i class="bi bi-house-door me-1"></i> Home</a>
            </li>
            @for (int i = 0; i < Model.Count; i++)
            {
                var item = Model[i];
                if (i == Model.Count - 1 || string.IsNullOrEmpty(item.Url))
                {
                    <li class="breadcrumb-item active text-dark fw-semibold text-truncate" aria-current="page" style="max-width: 350px;">
                        @item.Title
                    </li>
                }
                else
                {
                    <li class="breadcrumb-item">
                        <a href="@item.Url" class="text-decoration-none text-muted">@item.Title</a>
                    </li>
                }
            }
        </ol>
    </nav>
}
