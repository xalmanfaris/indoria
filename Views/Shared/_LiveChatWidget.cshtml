<!-- Floating Live Chat Bubble -->
<div id="liveChatBubbleContainer" class="live-chat-floating-btn" style="position: fixed; bottom: 24px; right: 24px; z-index: 1060;">
    <!-- Chat Toggle Trigger Button -->
    <button type="button" class="btn btn-primary rounded-circle shadow-lg d-flex align-items-center justify-content-center p-0"
            id="liveChatToggleBtn" onclick="toggleLiveChatModal()"
            style="width: 58px; height: 58px; background: linear-gradient(135deg, #1e40af, #3b82f6); border: 2px solid rgba(255,255,255,0.4); transition: transform 0.25s ease;"
            title="@Localizer["Customer Support"]">
        <i class="bi bi-chat-dots-fill text-white fs-4" id="liveChatIconOpen"></i>
        <i class="bi bi-x-lg text-white fs-4 d-none" id="liveChatIconClose"></i>
        <span class="position-absolute top-0 start-100 translate-middle p-1.5 bg-success border border-light rounded-circle" id="liveChatBubbleDot" title="@Localizer["Customer Care Online"]"></span>
    </button>

    <!-- Glassy Live Chat Box Popup Window -->
    <div class="card shadow-lg border-0 rounded-4 d-none overflow-hidden live-chat-box-window" id="liveChatBoxWindow"
         style="position: absolute; bottom: 70px; right: 0; width: 350px; max-width: calc(100vw - 32px); height: 470px; backdrop-filter: blur(20px); background: rgba(255, 255, 255, 0.98); border: 1px solid rgba(226, 232, 240, 0.8);">
        
        <!-- Header -->
        <div class="p-3 bg-primary text-white d-flex align-items-center justify-content-between shadow-sm">
            <div class="d-flex align-items-center gap-2">
                <div class="bg-white text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold shadow-sm" style="width: 34px; height: 34px;">
                    <i class="bi bi-headset" id="liveHeaderIcon"></i>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-1.5">
                        <h6 class="mb-0 fw-bold small">@Localizer["Indoria Support Desk"]</h6>
                    </div>
                    <div id="liveAgentStatusContainer">
                        <span class="badge bg-success text-white rounded-pill px-2.5 py-1 fw-bold shadow-sm d-inline-flex align-items-center gap-1" id="liveAgentStatusBadge" style="font-size: 0.7rem;">
                            <span class="spinner-grow spinner-grow-sm text-white me-1" style="width: 6px; height: 6px;"></span> @Localizer["Customer Care Online"]
                        </span>
                    </div>
                </div>
            </div>
            <div class="d-flex align-items-center gap-1">
                <button type="button" class="btn btn-sm btn-link text-white text-decoration-none p-1 opacity-75 hover-100" onclick="cancelUserLiveChat()" title="@Localizer["End Conversation"]">
                    <i class="bi bi-telephone-x"></i>
                </button>
                <button type="button" class="btn-close btn-close-white small ms-1" onclick="toggleLiveChatModal()" aria-label="Close"></button>
            </div>
        </div>

        <!-- Chat History Scroll View -->
        <div class="p-3 flex-grow-1 overflow-y-auto d-flex flex-column gap-2" id="liveChatMessagesList" style="height: 320px; background: rgba(248, 250, 252, 0.8);">
            <!-- Live Chat Ended Alert Banner -->
            <div id="liveChatEndedBanner" class="d-none alert alert-warning p-2.5 text-center rounded-3 mb-2 small fw-semibold shadow-sm border-warning" style="font-size: 0.78rem;">
                <i class="bi bi-exclamation-triangle-fill text-warning me-1"></i> Support Agent ended conversation. 
                <a href="#" onclick="resetLiveChatSession(event)" class="text-primary fw-bold text-decoration-underline ms-1">Start New Chat</a>
            </div>

            <!-- Welcome Agent Message -->
            <div class="d-flex align-items-start gap-2 max-w-85 me-auto" id="welcomeAgentMsg">
                <div class="bg-white text-dark border rounded-4 p-3 small shadow-sm">
                    <div class="fw-bold text-primary mb-1 style-readable" style="font-size: 0.75rem;">@Localizer["Indoria Support Desk"]</div>
                    Hello! Welcome to Indoria Support. How can we assist your appliance search, order status, or service request today?
                </div>
            </div>
        </div>

        <!-- Typing Indicator Element -->
        <div id="liveChatTypingIndicator" class="d-none px-3 py-2 bg-white border-top border-bottom text-muted small d-flex align-items-center gap-2">
            <div class="spinner-grow spinner-grow-sm text-primary" style="width: 6px; height: 6px;"></div>
            <div class="spinner-grow spinner-grow-sm text-primary" style="width: 6px; height: 6px; animation-delay: 0.15s;"></div>
            <div class="spinner-grow spinner-grow-sm text-primary" style="width: 6px; height: 6px; animation-delay: 0.3s;"></div>
            <span class="text-secondary font-monospace" style="font-size: 0.75rem;" id="typingIndicatorText">Indoria Support agent is typing...</span>
        </div>

        <!-- Quick Query Tags -->
        <div class="px-2 py-1 bg-light border-top d-flex gap-1 overflow-x-auto" style="scrollbar-width: none;" id="quickQueryBar">
            <button type="button" class="btn btn-xs btn-outline-primary text-nowrap rounded-pill py-0 px-2" onclick="sendQuickChatMessage('Where is my order?')">@Localizer["Track Order"]</button>
            <button type="button" class="btn btn-xs btn-outline-primary text-nowrap rounded-pill py-0 px-2" onclick="sendQuickChatMessage('What is your return policy?')">@Localizer["15-Day Return Policy"]</button>
            <button type="button" class="btn btn-xs btn-outline-primary text-nowrap rounded-pill py-0 px-2" onclick="sendQuickChatMessage('Do you offer warranty?')">@Localizer["2-Year Indoria Care"]</button>
        </div>

        <!-- Input Form Area -->
        <div class="p-2 border-top bg-white d-flex gap-2 align-items-center">
            <input type="text" class="form-control form-control-sm rounded-pill border bg-light px-3" 
                   id="liveChatInput" placeholder="@Localizer["Type a message..."]" onkeydown="if(event.key==='Enter') sendLiveChatMessage()" />
            <button type="button" class="btn btn-primary btn-sm rounded-circle p-0 d-flex align-items-center justify-content-center shadow-sm" 
                    id="liveChatSendBtn" onclick="sendLiveChatMessage()" style="width: 34px; height: 34px;">
                <i class="bi bi-send-fill text-white" style="font-size: 0.85rem;"></i>
            </button>
        </div>
    </div>
</div>
