@model AuraLiving.Models.CategoryViewModel

<a href="/category/@Model.Slug" class="aura-category-card text-decoration-none">
    <div class="aura-category-card-icon">
        <i class="bi @Model.Icon"></i>
    </div>
    <div class="aura-category-card-title">@Model.Name</div>
    <div class="aura-category-card-count">@Model.ProductCount+ Products</div>
</a>
