@model double

<div class="d-inline-flex align-items-center text-warning" title="@Model.ToString("0.0") out of 5 stars">
    @for (int i = 1; i <= 5; i++)
    {
        if (Model >= i)
        {
            <i class="bi bi-star-fill me-1" style="font-size: 0.85rem;"></i>
        }
        else if (Model >= i - 0.5)
        {
            <i class="bi bi-star-half me-1" style="font-size: 0.85rem;"></i>
        }
        else
        {
            <i class="bi bi-star me-1 text-muted opacity-50" style="font-size: 0.85rem;"></i>
        }
    }
</div>
