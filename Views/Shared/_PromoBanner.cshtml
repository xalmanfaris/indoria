<div class="aura-flash-deal-card">
    <div class="row align-items-center g-4 g-lg-5">
        <!-- Left Text & Controls -->
        <div class="col-lg-7">
            <!-- Header Badges -->
            <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                <span class="aura-flash-badge">
                    <i class="bi bi-lightning-fill"></i> @Localizer["Trending Collection"]
                </span>
                <span class="aura-flash-coupon-pill">
                    <i class="bi bi-ticket-perforated-fill text-warning"></i> @Localizer["Exclusive Deals"]
                </span>

            </div>

            <!-- Title & Description -->
            <h2 class="text-white fw-bold mb-3 display-6" style="letter-spacing: -0.02em;">@Localizer["Elevate Your Living Space"]</h2>
            <p class="text-light opacity-85 mb-4 fs-6" style="max-width: 580px; line-height: 1.65;">
                @Localizer["Curated Launch Deals & Private Offers"]
            </p>
            
            <!-- Live Countdown Timer -->
            <div class="d-flex align-items-center flex-wrap gap-2 mb-4">
                <div class="aura-flash-timer-box">
                    <span class="aura-flash-timer-val" id="dealHours">14</span>
                    <span class="aura-flash-timer-sub">Hours</span>
                </div>
                <span class="text-white fw-bold fs-4 opacity-50">:</span>
                <div class="aura-flash-timer-box">
                    <span class="aura-flash-timer-val" id="dealMins">41</span>
                    <span class="aura-flash-timer-sub">Mins</span>
                </div>
                <span class="text-white fw-bold fs-4 opacity-50">:</span>
                <div class="aura-flash-timer-box">
                    <span class="aura-flash-timer-val" id="dealSecs">41</span>
                    <span class="aura-flash-timer-sub">Secs</span>
                </div>
                <div class="ms-sm-3 text-light opacity-75 small mt-2 mt-sm-0 w-100 w-sm-auto">
                    <i class="bi bi-info-circle me-1 text-warning"></i> @Localizer["Free Shipping"]
                </div>
            </div>

            <!-- Action CTAs -->
            <div class="d-flex flex-column flex-sm-row gap-3">
                <a href="/products" class="btn aura-btn-flash-action rounded-pill px-4.5 py-3 fw-bold shadow-lg">
                    @Localizer["Shop Now"] <i class="bi bi-arrow-right ms-2"></i>
                </a>
                <a href="/category/refrigerators" class="btn aura-flash-coupon-pill px-4 py-3 text-center justify-content-center">
                    @Localizer["Smart Refrigerators"]
                </a>
            </div>
        </div>

        <!-- Right Image Showcase -->
        <div class="col-lg-5">
            <div class="aura-flash-img-frame">
                <img src="/images/samsung-refrigilator.webp" 
                     alt="Samsung Bespoke AI Refrigerator Flash Deal" 
                     class="img-fluid" 
                     referrerpolicy="no-referrer" 
                     onerror="this.onerror=null;this.src='/images/homixa_hero_appliances.jpg';" />
                <div class="position-absolute bottom-0 start-50 translate-middle-x mb-3 px-3 py-2 rounded-pill bg-dark bg-opacity-90 text-white border border-light border-opacity-25 small shadow-lg d-flex align-items-center gap-2" style="backdrop-filter: blur(12px); white-space: nowrap;">
                    <i class="bi bi-tag-fill text-warning"></i> <strong>@Localizer["Curated Launch Deals & Private Offers"]</strong> • @Localizer["Free Shipping"]
                </div>
            </div>
        </div>
    </div>
</div>
