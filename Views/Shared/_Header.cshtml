@inject AuraLiving.Services.ICurrencyService CurrencyService
@inject AuraLiving.Services.ILocalizationService LocalizationService
@inject AuraLiving.Services.ICountryService CountryService

@{
    var activeCurrency = CurrencyService.GetCurrentCurrency();
    var currencies = CurrencyService.GetSupportedCurrencies();

    var activeLanguage = LocalizationService.GetCurrentLanguage();
    var languages = LocalizationService.GetSupportedLanguages();

    var activeCountry = CountryService.GetCurrentCountry();
    var countries = CountryService.GetSupportedCountries();
}

<script>window.isUserAuthenticated = @(User.Identity?.IsAuthenticated == true ? "true" : "false");</script>
<header class="aura-header homixa-header">
    <div class="container py-2">
        <div class="d-flex align-items-center justify-content-between gap-2 gap-md-3">
            <!-- Left: Indoria Brand Logo -->
            <a href="/" class="homixa-brand text-decoration-none">
                <span class="homixa-brand-name">Indoria</span>
            </a>

            <!-- Center Navigation Links -->
            <nav class="homixa-main-nav d-none d-lg-flex align-items-center gap-4">
                <a href="/" class="homixa-nav-link active">@LocalizationService.GetString("Home")</a>
                <a href="/categories" class="homixa-nav-link">@LocalizationService.GetString("Categories")</a>
                <a href="/products" class="homixa-nav-link">@LocalizationService.GetString("Shop")</a>
                <a href="/category/smart-tvs" class="homixa-nav-link">Smart TVs</a>
                <a href="/category/kitchen-appliances" class="homixa-nav-link">Kitchen</a>
                <a href="/category/refrigerators" class="homixa-nav-link">Cooling</a>
                <a href="/category/washing-machines" class="homixa-nav-link">Laundry</a>
            </nav>

            <!-- Right Actions: Region Selectors, Search Icon, Notifications, Theme Toggle, Account, Cart -->
            <div class="d-flex align-items-center gap-2 gap-sm-3">
                
                <!-- Regional Preferences Dropdown (Country / Currency / Language) -->
                <div class="dropdown d-none d-md-block">
                    <button class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-1 text-nowrap d-flex align-items-center gap-1 border-0" 
                            type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Region & Currency">
                        <span>@activeCountry.Flag</span>
                        <span class="fw-semibold small ms-1">@activeCurrency.Code</span>
                        <i class="bi bi-chevron-down" style="font-size: 0.75rem;"></i>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4 mt-2 p-3" style="min-width: 260px;">
                        <h6 class="dropdown-header px-0 text-uppercase fw-bold text-muted small mb-2">Regional Preferences</h6>
                        
                        <!-- Country Picker -->
                        <div class="mb-2">
                            <label class="form-label text-xs fw-semibold text-muted mb-1">Shipping Country</label>
                            <select class="form-select form-select-sm rounded-3" id="headerCountrySelect" onchange="changeAppCountry(this.value)">
                                @foreach (var country in countries)
                                {
                                    <option value="@country.Code" selected="@(country.Code == activeCountry.Code)">
                                        @country.Flag @country.Name
                                    </option>
                                }
                            </select>
                        </div>

                        <!-- Currency Picker -->
                        <div class="mb-2">
                            <label class="form-label text-xs fw-semibold text-muted mb-1">Currency</label>
                            <select class="form-select form-select-sm rounded-3" id="headerCurrencySelect" onchange="changeAppCurrency(this.value)">
                                @foreach (var curr in currencies)
                                {
                                    <option value="@curr.Code" selected="@(curr.Code == activeCurrency.Code)">
                                        @curr.Code (@curr.Symbol) - @curr.Name
                                    </option>
                                }
                            </select>
                        </div>

                        <!-- Language Picker -->
                        <div>
                            <label class="form-label text-xs fw-semibold text-muted mb-1">Language</label>
                            <select class="form-select form-select-sm rounded-3" id="headerLanguageSelect" onchange="changeAppLanguage(this.value)">
                                @foreach (var lang in languages)
                                {
                                    <option value="@lang.Code" selected="@(lang.Code == activeLanguage.Code)">
                                        @lang.Flag @lang.NativeName
                                    </option>
                                }
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Search Toggle Button + Expanding Capsule -->
                <div class="aura-search-inline-box" id="auraSearchInlineExpand">
                    <button type="button" class="homixa-icon-btn" id="searchTriggerBtn" title="Search" aria-label="Search">
                        <i class="bi bi-search"></i>
                    </button>
                    <form action="/search" method="get" class="aura-search-capsule" role="search">
                        <i class="bi bi-search aura-search-capsule-icon"></i>
                        <input type="text" name="q" class="form-control aura-search-capsule-input" id="topNavSearchInput"
                               placeholder="Search appliances..." 
                               aria-label="Search appliances" autocomplete="off" />
                        <button type="button" class="aura-search-capsule-close" id="searchCloseBtn" aria-label="Close search">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </form>
                    <!-- Live Instant Search Results Dropdown Panel -->
                    <div class="aura-search-live-dropdown shadow-lg rounded-4 p-2" id="auraSearchResultsDropdown"></div>
                </div>

                <!-- 1. Capsule Theme Switcher Pill (Sun / Moon) -->
                <div class="aura-theme-pill-toggle ms-1" id="themePillToggle" onclick="toggleAppTheme()" title="Toggle Light / Dark Mode" role="button" tabindex="0">
                    <div class="aura-theme-pill-btn aura-theme-pill-sun">
                        <i class="bi bi-sun-fill"></i>
                    </div>
                    <div class="aura-theme-pill-btn aura-theme-pill-moon">
                        <i class="bi bi-moon-stars-fill"></i>
                    </div>
                </div>

                <!-- 2. Customer Notifications Bell Panel -->
                <div class="dropdown">
                    <button type="button" class="aura-nav-icon-btn" id="notificationsBellBtn" data-bs-toggle="dropdown" aria-expanded="false" title="Notifications" aria-label="Notifications">
                        <i class="bi bi-bell"></i>
                        <span class="aura-nav-badge-red aura-unread-count" id="headerUnreadBadge" style="display: none;">0</span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4 mt-2 p-0" style="width: 320px; max-height: 400px; overflow-y: auto;" id="notificationsDropdownPanel">
                        <div class="d-flex align-items-center justify-content-between p-3 border-bottom">
                            <span class="fw-bold text-dark small"><i class="bi bi-bell-fill text-primary me-1"></i> Notifications</span>
                            <button class="btn btn-link btn-sm text-decoration-none p-0 text-muted small" onclick="markAllNotificationsRead()">Mark all as read</button>
                        </div>
                        <div class="p-3 text-center text-muted small" id="notificationsListContainer">
                            <div class="spinner-border spinner-border-sm text-primary my-2" role="status"></div>
                            <div>Loading alerts...</div>
                        </div>
                    </div>
                </div>

                <!-- 3. Wishlist Link with Count Badge -->
                <a href="/wishlist" class="aura-nav-icon-btn" title="Wishlist" aria-label="Wishlist">
                    <i class="bi bi-heart"></i>
                    <span class="aura-nav-badge-red aura-wishlist-count">0</span>
                </a>

                <!-- 4. Cart Link with Count Badge -->
                <a href="/cart" class="aura-nav-icon-btn" title="Shopping Bag" aria-label="Shopping Bag">
                    <i class="bi bi-bag"></i>
                    <span class="aura-nav-badge-red aura-cart-badge">0</span>
                </a>

                <!-- 5. User Profile Avatar Dropdown -->
                <div class="dropdown">
                    <button class="btn p-0 border-0 bg-transparent d-flex align-items-center gap-1" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Account" aria-label="Account">
                        <div class="aura-nav-avatar">
                            <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=120&q=80" alt="User Profile" class="aura-avatar-img" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                            <div class="aura-avatar-fallback" style="display: none;">
                                <i class="bi bi-person-fill"></i>
                            </div>
                        </div>
                        <i class="bi bi-chevron-down text-muted ms-0.5" style="font-size: 0.75rem;"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4 mt-2 p-2" style="min-width: 220px;">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="px-3 py-2 border-bottom mb-1">
                                <div class="fw-bold text-dark">@(User.Identity.Name ?? "Patron Account")</div>
                                <small class="text-muted">@(User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "")</small>
                            </li>
                            <li><a class="dropdown-item rounded-3 py-2" href="/account"><i class="bi bi-speedometer2 me-2 text-primary"></i> Dashboard</a></li>
                            <li><a class="dropdown-item rounded-3 py-2" href="/account/orders"><i class="bi bi-box-seam me-2 text-primary"></i> My Orders</a></li>
                            <li><a class="dropdown-item rounded-3 py-2" href="/account/tickets"><i class="bi bi-headset me-2 text-success"></i> Support Tickets</a></li>
                            <li><a class="dropdown-item rounded-3 py-2" href="/account/addresses"><i class="bi bi-geo-alt me-2 text-primary"></i> Saved Addresses</a></li>
                            <li><a class="dropdown-item rounded-3 py-2" href="/account/profile"><i class="bi bi-person-gear me-2 text-primary"></i> Profile Settings</a></li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li><a class="dropdown-item rounded-3 py-2 text-warning fw-semibold" href="/admin"><i class="bi bi-shield-lock-fill me-2"></i> Admin Console</a></li>
                                <li><a class="dropdown-item rounded-3 py-2 text-info fw-semibold" href="/admin/tickets"><i class="bi bi-ticket-perforated me-2"></i> Support Console</a></li>
                            }
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form method="post" action="/account/logout" class="d-inline">
                                    <button type="submit" class="dropdown-item rounded-3 py-2 text-danger border-0 bg-transparent w-100 text-start">
                                        <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="px-3 py-2 border-bottom mb-1">
                                <div class="fw-bold text-dark">Welcome to Indoria</div>
                                <small class="text-muted">Sign in to access your profile</small>
                            </li>
                            <li><a class="dropdown-item rounded-3 py-2 fw-bold text-primary" href="/login"><i class="bi bi-box-arrow-in-right me-2"></i> Sign In</a></li>
                            <li><a class="dropdown-item rounded-3 py-2" href="/register"><i class="bi bi-person-plus me-2 text-success"></i> Create Account</a></li>
                            <li><a class="dropdown-item rounded-3 py-2" href="/account/tickets"><i class="bi bi-headset me-2 text-info"></i> Support Desk</a></li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</header>
