@inject AuraLiving.Services.ILocalizationService LocalizationService
@{
    var isRtl = LocalizationService.IsRtl();
    var currentLang = LocalizationService.GetCurrentLanguageCode();
}
<!DOCTYPE html>
<html lang="@currentLang" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} | Indoria" : "Indoria - Premium Home Appliances Marketplace")</title>
    <!-- Early Theme Detection to Avoid FOUC -->
    <script>
        (function () {
            try {
                var saved = localStorage.getItem('indoria-theme') === 'dark' ? 'dark' : 'light';
                document.documentElement.setAttribute('data-theme', saved);
                document.documentElement.setAttribute('data-bs-theme', saved);
            } catch (e) { }
        })();
        window.currentLangCode = "@currentLang";
        window.isAppRtl = @(isRtl ? "true" : "false");
        window.AppTranslations = {
            "Item added to cart": "@Html.Raw(LocalizationService.GetString("Item added to cart"))",
            "Coupon applied successfully!": "@Html.Raw(LocalizationService.GetString("Coupon applied successfully!"))",
            "Added!": "@Html.Raw(LocalizationService.GetString("Added!"))",
            "Search appliances...": "@Html.Raw(LocalizationService.GetString("Search appliances..."))",
            "No matching products found for": "@Html.Raw(LocalizationService.GetString("No matching products found for"))",
            "See all results for": "@Html.Raw(LocalizationService.GetString("See all results for"))",
            "Customer Care Online": "@Html.Raw(LocalizationService.GetString("Customer Care Online"))",
            "AI Assistant Active": "@Html.Raw(LocalizationService.GetString("AI Assistant Active"))",
            "Type a message...": "@Html.Raw(LocalizationService.GetString("Type a message..."))",
            "Delivery available to": "@Html.Raw(LocalizationService.GetString("Delivery available to"))",
            "Check": "@Html.Raw(LocalizationService.GetString("Check"))"
        };
    </script>

    <!-- Google Fonts: Cairo (Arabic), Montserrat Alternates, Dancing Script, Great Vibes, Montserrat & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800&family=Dancing+Script:wght@600;700;800&family=Great+Vibes&family=Montserrat+Alternates:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,700&family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5.3.3 & Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">


    <!-- Custom Design System -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- Header -->
    <partial name="_Header" />

    <!-- Main Content Body -->
    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- Footer -->
    <partial name="_Footer" />

    <!-- Shared Modals & Notifications & Live Support Chat -->
    <partial name="_QuickViewModal" />
    <partial name="_Toast" />
    <partial name="_LiveChatWidget" />
    <partial name="_LogoutModal" />

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
