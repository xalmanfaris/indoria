@model List<AuraLiving.Models.AddressViewModel>
@{
    ViewData["Title"] = "Saved Addresses";
    var breadcrumbs = new List<(string Title, string Url)>
    {
        ("My Account", "/account"),
        ("Saved Addresses", "")
    };
}

<div class="container py-4">
    <partial name="_Breadcrumb" model="breadcrumbs" />

    <div class="row g-4">
        <div class="col-lg-3">
            <partial name="_AccountSidebar" />
        </div>

        <div class="col-lg-9">
            <div class="p-4 p-md-5 rounded-4 bg-white border shadow-sm">
                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 pb-3 border-bottom gap-2">
                    <div>
                        <h3 class="fw-bold text-dark mb-1">Saved Delivery Destinations</h3>
                        <p class="text-secondary small mb-0">Manage your residential and commercial white-glove setup locations.</p>
                    </div>
                    <button class="btn aura-btn-primary btn-sm rounded-pill px-4 py-2 font-weight-bold" data-bs-toggle="modal" data-bs-target="#addAddressModal">
                        <i class="bi bi-plus-lg me-1"></i> Add New Address
                    </button>
                </div>

                <div class="row g-3">
                    @if (Model == null || !Model.Any())
                    {
                        <div class="col-12 text-center py-5">
                            <div class="p-4 rounded-4 bg-light border">
                                <i class="bi bi-geo-alt display-4 text-muted mb-3 d-block"></i>
                                <h5 class="fw-bold text-dark mb-1">No Saved Addresses Found</h5>
                                <p class="text-secondary small mb-3">You haven't saved any delivery addresses yet. Add your address to speed up checkout.</p>
                                <button class="btn aura-btn-primary btn-sm rounded-pill px-4 py-2" data-bs-toggle="modal" data-bs-target="#addAddressModal">
                                    <i class="bi bi-plus-lg me-1"></i> Add Delivery Address
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        @foreach (var addr in Model)
                        {
                            <div class="col-md-6">
                                <div class="p-4 rounded-4 border @(addr.IsDefault ? "border-primary bg-primary bg-opacity-10" : "bg-white") shadow-sm h-100 d-flex flex-column justify-content-between">
                                    <div>
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <h5 class="fw-bold text-dark mb-0">@addr.FullName</h5>
                                            <div>
                                                <span class="badge bg-secondary text-light rounded-pill px-2.5">@addr.Type</span>
                                                @if (addr.IsDefault)
                                                {
                                                    <span class="badge bg-primary rounded-pill px-2.5 ms-1">Default</span>
                                                }
                                            </div>
                                        </div>

                                        <div class="text-secondary small mb-3 style-readable" style="line-height: 1.65;">
                                            <div>@addr.AddressLine1</div>
                                            @if (!string.IsNullOrEmpty(addr.AddressLine2))
                                            {
                                                <div>@addr.AddressLine2</div>
                                            }
                                            <div>@addr.City, @addr.State - <strong>@addr.Pincode</strong></div>
                                            @if (!string.IsNullOrEmpty(addr.Landmark))
                                            {
                                                <div class="text-muted"><i class="bi bi-pin-map me-1"></i> Landmark: @addr.Landmark</div>
                                            }
                                            <div class="mt-2 text-dark"><i class="bi bi-telephone me-1 text-primary"></i> Phone: <strong>@addr.Phone</strong></div>
                                        </div>
                                    </div>

                                    <div class="d-flex gap-2 pt-3 border-top justify-content-end">
                                        <form method="post" action="/account/addresses/delete/@addr.Id" onsubmit="return confirm('Delete this saved address?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                                <i class="bi bi-trash3 me-1"></i> Delete
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Address Modal -->
<div class="modal fade" id="addAddressModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-bottom px-4 py-3">
                <h5 class="modal-title fw-bold text-dark"><i class="bi bi-geo-alt-fill text-primary me-2"></i> Add New Delivery Destination</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" action="/account/addresses/save">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Recipient Full Name</label>
                            <input type="text" name="FullName" class="form-control rounded-3 py-2" required placeholder="e.g. Rahul Sharma" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Mobile Phone Number</label>
                            <input type="tel" name="Phone" class="form-control rounded-3 py-2" required placeholder="+91 98765 43210" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Flat, House No., Building, Apartment</label>
                            <input type="text" name="AddressLine1" class="form-control rounded-3 py-2" required placeholder="Flat 402, Highrise Heights" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Street, Sector, Area, Locality</label>
                            <input type="text" name="AddressLine2" class="form-control rounded-3 py-2" placeholder="MG Road, Sector 15" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">City</label>
                            <input type="text" name="City" class="form-control rounded-3 py-2" required placeholder="Mumbai" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">State</label>
                            <input type="text" name="State" class="form-control rounded-3 py-2" required placeholder="Maharashtra" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Pincode</label>
                            <input type="text" name="Pincode" class="form-control rounded-3 py-2" required placeholder="400001" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Landmark (Optional)</label>
                            <input type="text" name="Landmark" class="form-control rounded-3 py-2" placeholder="Near Central Park" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Address Type</label>
                            <select name="Type" class="form-select rounded-3 py-2">
                                <option value="Home">Home (All-day delivery)</option>
                                <option value="Work">Work (Delivery between 10 AM - 6 PM)</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="IsDefault" value="true" id="isDefaultCheck" checked>
                                <label class="form-check-label small text-secondary" for="isDefaultCheck">
                                    Set as default shipping destination
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top px-4 py-3">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn aura-btn-primary rounded-pill px-5 fw-bold shadow-sm">Save Address</button>
                </div>
            </form>
        </div>
    </div>
</div>
