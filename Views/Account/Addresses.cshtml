@model List<AuraLiving.Models.AddressViewModel>
@{
    ViewData["Title"] = "Saved Addresses";
}

<div class="container py-4">
    <div class="row g-4">
        <div class="col-lg-3">
            <partial name="_AccountSidebar" />
        </div>

        <div class="col-lg-9">
            <div class="p-4 p-md-5 rounded-4 bg-white border shadow-sm">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h3 class="fw-bold text-dark mb-1">Saved Addresses</h3>
                        <p class="text-muted small mb-0">Manage your residential and commercial delivery destinations.</p>
                    </div>
                    <button class="btn aura-btn-primary btn-sm rounded-pill" data-bs-toggle="modal" data-bs-target="#addAddressModal">
                        <i class="bi bi-plus-lg me-1"></i> Add New Address
                    </button>
                </div>

                <div class="row g-3">
                    @foreach (var addr in Model)
                    {
                        <div class="col-md-6">
                            <div class="p-4 rounded-4 border @(addr.IsDefault ? "border-primary bg-primary-subtle bg-opacity-10" : "bg-light") h-100 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <h5 class="fw-bold text-dark mb-0">@addr.FullName</h5>
                                        <div>
                                            <span class="badge bg-secondary text-light">@addr.Type</span>
                                            @if (addr.IsDefault)
                                            {
                                                <span class="badge bg-primary ms-1">Default</span>
                                            }
                                        </div>
                                    </div>

                                    <div class="text-secondary small mb-3">
                                        <div>@addr.AddressLine1</div>
                                        <div>@addr.AddressLine2</div>
                                        <div>@addr.City, @addr.State - <strong>@addr.Pincode</strong></div>
                                        @if (!string.IsNullOrEmpty(addr.Landmark))
                                        {
                                            <div class="text-muted">Landmark: @addr.Landmark</div>
                                        }
                                        <div class="mt-2"><i class="bi bi-telephone me-1"></i> @addr.Phone</div>
                                    </div>
                                </div>

                                <div class="d-flex gap-2 pt-3 border-top">
                                    <button class="btn btn-sm btn-outline-secondary rounded-pill" onclick="showAuraToast('Edit address modal demo', 'dark');">
                                        <i class="bi bi-pencil me-1"></i> Edit
                                    </button>
                                    @if (!addr.IsDefault)
                                    {
                                        <button class="btn btn-sm btn-outline-primary rounded-pill" onclick="showAuraToast('Set as default address', 'success');">
                                            Make Default
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger rounded-pill ms-auto" onclick="showAuraToast('Address removed', 'dark'); this.closest('.col-md-6').remove();">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Address Modal -->
<div class="modal fade" id="addAddressModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Add Delivery Address</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form onsubmit="event.preventDefault(); showAuraToast('New address saved successfully!', 'success'); bootstrap.Modal.getInstance(document.getElementById('addAddressModal')).hide();">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Recipient Full Name</label>
                            <input type="text" class="form-control form-control-sm" required placeholder="e.g. Arjun Mehta" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">10-Digit Mobile</label>
                            <input type="tel" class="form-control form-control-sm" required placeholder="98201 45890" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Flat, Floor, Building Name</label>
                            <input type="text" class="form-control form-control-sm" required placeholder="Flat 402, Tower 3" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Street, Road, Area</label>
                            <input type="text" class="form-control form-control-sm" required placeholder="Main Boulevard" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">City</label>
                            <input type="text" class="form-control form-control-sm" required placeholder="Mumbai" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">PIN Code</label>
                            <input type="text" class="form-control form-control-sm" required placeholder="400001" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-secondary btn-sm rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn aura-btn-primary btn-sm rounded-pill px-4">Save Address</button>
                </div>
            </form>
        </div>
    </div>
</div>
