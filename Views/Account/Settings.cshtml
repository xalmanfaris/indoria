@{
    ViewData["Title"] = "Account Security & Settings";
}

<div class="container py-4">
    <div class="row g-4">
        <div class="col-lg-3">
            <partial name="_AccountSidebar" />
        </div>

        <div class="col-lg-9">
            <div class="p-4 p-md-5 rounded-4 bg-white border shadow-sm mb-4">
                <h3 class="fw-bold text-dark mb-1">Security &amp; Password</h3>
                <p class="text-muted small mb-4">Manage your credentials and safeguard your account.</p>

                <form onsubmit="event.preventDefault(); showAuraToast('Password updated successfully!', 'success'); this.reset();">
                    <div class="row g-3 mb-4" style="max-width: 500px;">
                        <div class="col-12">
                            <label class="form-label small fw-bold">Current Password</label>
                            <input type="password" class="form-control" required placeholder="••••••••" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">New Password</label>
                            <input type="password" class="form-control" required placeholder="At least 8 characters" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Confirm New Password</label>
                            <input type="password" class="form-control" required placeholder="Re-enter new password" />
                        </div>
                    </div>
                    <button type="submit" class="btn aura-btn-primary rounded-pill px-4 py-2 fw-bold">
                        Update Password
                    </button>
                </form>

                <hr class="my-4" />

                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="fw-bold text-dark mb-1">Two-Factor Authentication (2FA)</h6>
                        <p class="text-muted small mb-0">Protect logins with SMS OTP verification.</p>
                    </div>
                    <button class="btn btn-outline-primary btn-sm rounded-pill" onclick="showAuraToast('2FA is active on +91 98201 45890', 'success');">
                        Enabled
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
