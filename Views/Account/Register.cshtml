@model AuraLiving.Models.RegisterRequestDto
@{
    ViewData["Title"] = "Create an Indoria Account";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="p-4 p-md-5 rounded-4 bg-white border shadow-sm text-center">
                <a href="/" class="aura-brand justify-content-center mb-3 text-decoration-none">
                    <span class="aura-brand-name">Indoria</span>
                </a>

                <h3 class="fw-bold text-dark mb-1">Join Indoria Privilege</h3>
                <p class="text-muted small mb-4">Create your patron account to track order shipments, manage addresses, and access VIP rewards.</p>

                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="alert alert-danger rounded-3 py-2 px-3 small mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i> @ViewBag.ErrorMessage
                    </div>
                }

                <form method="post" action="/account/register">
                    <div class="text-start mb-3">
                        <label class="form-label small fw-bold text-dark">Full Name</label>
                        <input type="text" name="FullName" class="form-control py-2.5" placeholder="e.g. Vikram Sharma" value="@(Model?.FullName ?? "")" required />
                    </div>

                    <div class="text-start mb-3">
                        <label class="form-label small fw-bold text-dark">Mobile Number</label>
                        <input type="tel" name="Phone" class="form-control py-2.5" placeholder="+91 98201 45890" value="@(Model?.Phone ?? "")" required />
                    </div>

                    <div class="text-start mb-3">
                        <label class="form-label small fw-bold text-dark">Email Address</label>
                        <input type="email" name="Email" class="form-control py-2.5" placeholder="name@example.com" value="@(Model?.Email ?? "")" required />
                    </div>

                    <div class="text-start mb-4">
                        <label class="form-label small fw-bold text-dark">Create Password</label>
                        <input type="password" name="Password" class="form-control py-2.5" placeholder="At least 6 characters" required />
                    </div>

                    <div class="form-check text-start mb-4">
                        <input class="form-check-input" type="checkbox" id="termsCheck" required checked />
                        <label class="form-check-label small text-muted" for="termsCheck">
                            I agree to the <a href="/terms" class="text-primary text-decoration-none">Terms of Service</a> and <a href="/privacy" class="text-primary text-decoration-none">Privacy Policy</a>.
                        </label>
                    </div>

                    <button type="submit" class="btn aura-btn-primary w-100 py-3 fw-bold rounded-pill mb-4 shadow-sm">
                        Create Account <i class="bi bi-arrow-right ms-1"></i>
                    </button>

                    <p class="small text-muted mb-0">
                        Already have an Indoria account? <a href="/login" class="text-primary fw-bold text-decoration-none">Sign In</a>
                    </p>
                </form>
            </div>
        </div>
    </div>
</div>
