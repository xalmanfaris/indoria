@model AuraLiving.Models.ProfileViewModel
@{
    ViewData["Title"] = "My Profile Settings";
}

<div class="container py-4">
    <div class="row g-4">
        <div class="col-lg-3">
            <partial name="_AccountSidebar" />
        </div>

        <div class="col-lg-9">
            <div class="p-4 p-md-5 rounded-4 bg-white border shadow-sm">
                <h3 class="fw-bold text-dark mb-4">Personal Profile Information</h3>

                <form onsubmit="event.preventDefault(); showAuraToast('Profile information updated successfully!', 'success');">
                    <!-- Avatar Section -->
                    <div class="d-flex align-items-center gap-4 mb-4 pb-4 border-bottom">
                        <div class="rounded-circle bg-primary text-white fw-bold d-flex align-items-center justify-content-center" style="width: 72px; height: 72px; font-size: 1.6rem;">
                            AM
                        </div>
                        <div>
                            <h5 class="fw-bold text-dark mb-1">@Model.FullName</h5>
                            <p class="text-muted small mb-2">Member since @Model.MemberSince</p>
                            <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill" onclick="showAuraToast('Photo upload demo ready', 'dark');">
                                <i class="bi bi-camera me-1"></i> Change Photo
                            </button>
                        </div>
                    </div>

                    <!-- Profile Form Fields -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-dark">Full Name</label>
                            <input type="text" class="form-control" value="@Model.FullName" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-dark">Email Address</label>
                            <input type="email" class="form-control" value="@Model.Email" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-dark">Mobile Number</label>
                            <input type="tel" class="form-control" value="@Model.Phone" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-bold text-dark">Gender</label>
                            <select class="form-select">
                                <option selected="@(Model.Gender == "Male")">Male</option>
                                <option selected="@(Model.Gender == "Female")">Female</option>
                                <option selected="@(Model.Gender == "Other")">Other</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-bold text-dark">Date of Birth</label>
                            <input type="date" class="form-control" value="@Model.DateOfBirth" />
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn aura-btn-primary rounded-pill px-4 py-2 fw-bold">
                            Save Changes
                        </button>
                        <button type="reset" class="btn aura-btn-outline rounded-pill px-4 py-2">
                            Cancel
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
