@model List<AuraLiving.Models.ReturnRequestViewModel>
@{
    ViewData["Title"] = "Returns & Replacements";
}

<div class="container py-4">
    <div class="row g-4">
        <div class="col-lg-3">
            <partial name="_AccountSidebar" />
        </div>

        <div class="col-lg-9">
            <div class="p-4 p-md-5 rounded-4 bg-white border shadow-sm">
                <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                    <div>
                        <h3 class="fw-bold text-dark mb-1">Returns &amp; Replacements</h3>
                        <p class="text-muted small mb-0">15-Day hassle-free return window on all verified purchases.</p>
                    </div>
                    <button class="btn aura-btn-primary btn-sm rounded-pill" data-bs-toggle="modal" data-bs-target="#requestReturnModal">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Request New Return
                    </button>
                </div>

                @if (Model.Any())
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var ret in Model)
                        {
                            <div class="p-4 rounded-4 border bg-light shadow-sm">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <div>
                                        <span class="text-muted small">Return ID:</span>
                                        <strong class="text-dark">#@ret.Id</strong>
                                        <span class="text-muted small ms-2">• Order: #@ret.OrderId</span>
                                    </div>
                                    <span class="badge bg-warning text-dark px-3 py-1">@ret.Status</span>
                                </div>
                                <h5 class="fw-bold text-dark mb-1">@ret.ProductName</h5>
                                <p class="text-secondary small mb-2"><strong>Reason:</strong> @ret.Reason</p>
                                <div class="d-flex justify-content-between align-items-center text-muted small pt-2 border-top">
                                    <span>Requested on: @ret.RequestDate</span>
                                    <span>Estimated Refund: <strong class="text-dark">₹@ret.RefundAmount.ToString("N0")</strong> (to Original Payment Method)</span>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <p>No active return requests.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Request Return Modal -->
<div class="modal fade" id="requestReturnModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Initiate Return / Replacement</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form onsubmit="event.preventDefault(); showAuraToast('Return request submitted! An Aura executive will inspect and schedule pickup.', 'success'); bootstrap.Modal.getInstance(document.getElementById('requestReturnModal')).hide();">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Select Eligible Order</label>
                        <select class="form-select form-select-sm" required>
                            <option>Order #AURA-98214 - Samsung Bespoke Fridge</option>
                            <option>Order #AURA-83421 - Dyson V15 Vacuum</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Reason for Return</label>
                        <select class="form-select form-select-sm" required>
                            <option>Dimensions do not fit kitchen space</option>
                            <option>Transit dent or cosmetic scratch on unboxing</option>
                            <option>Received incorrect variant / color</option>
                            <option>Technical malfunction / electrical noise</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Additional Comments / Remarks</label>
                        <textarea class="form-control form-control-sm" rows="3" placeholder="Provide any details to expedite pickup..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-secondary btn-sm rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn aura-btn-primary btn-sm rounded-pill px-4">Submit Request</button>
                </div>
            </form>
        </div>
    </div>
</div>
