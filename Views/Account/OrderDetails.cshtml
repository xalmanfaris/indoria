@model AuraLiving.Models.OrderViewModel
@{
    ViewData["Title"] = $"Order #{Model.Id} Details";
    var breadcrumbs = new List<(string Title, string Url)>
    {
        ("My Account", "/account"),
        ("Orders History", "/account/orders"),
        ($"Order #{Model.Id}", "")
    };
}

<div class="container py-4">
    <partial name="_Breadcrumb" model="breadcrumbs" />

    <div class="row g-4">
        <div class="col-lg-3">
            <partial name="_AccountSidebar" />
        </div>

        <div class="col-lg-9">
            <div class="p-4 p-md-5 rounded-4 bg-white border shadow-sm mb-4">
                <!-- Header -->
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom gap-2">
                    <div>
                        <a href="/account/orders" class="text-primary small text-decoration-none d-inline-block mb-1 fw-bold">&larr; Back to all orders</a>
                        <h3 class="fw-bold text-dark mb-0">Order #@Model.Id</h3>
                        <small class="text-muted">Placed on @Model.OrderDate.ToString("dd MMMM yyyy, hh:mm tt")</small>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <a href="/account/orders/@Model.Id/invoice" target="_blank" class="btn btn-outline-dark btn-sm rounded-pill px-3 fw-semibold">
                            <i class="bi bi-file-earmark-pdf-fill text-danger me-1"></i> Tax Invoice PDF
                        </a>
                        @if (Model.Status != "Cancelled" && Model.Status != "Delivered")
                        {
                            <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-bold" data-bs-toggle="modal" data-bs-target="#cancelOrderModal">
                                <i class="bi bi-x-circle me-1"></i> Cancel Order
                            </button>
                        }
                        <span class="badge @(Model.Status == "Delivered" ? "bg-success" : Model.Status == "Cancelled" ? "bg-danger" : "bg-primary") px-3.5 py-2 rounded-pill font-weight-bold fs-7">
                            <i class="bi @(Model.Status == "Cancelled" ? "bi-x-circle" : "bi-truck") me-1"></i> @Model.Status
                        </span>
                    </div>
                </div>

                @if (Model.Status == "Cancelled")
                {
                    <div class="p-3.5 rounded-4 bg-danger bg-opacity-10 border border-danger border-opacity-25 mb-4">
                        <div class="d-flex align-items-center gap-2 text-danger fw-bold mb-1">
                            <i class="bi bi-x-circle-fill fs-5"></i> Order Cancelled
                        </div>
                        <p class="text-danger text-opacity-90 small mb-1">
                            Reason: <strong>@(Model.CancellationReason ?? "Customer requested cancellation")</strong>
                        </p>
                        @if (Model.CancellationDate.HasValue)
                        {
                            <small class="text-muted">Cancelled on @Model.CancellationDate.Value.ToString("dd MMMM yyyy, hh:mm tt")</small>
                        }
                    </div>
                }

                <!-- Shipment Tracking Timeline -->
                <div class="p-4 rounded-4 bg-light mb-4 border">
                    <h5 class="fw-bold text-dark mb-3"><i class="bi bi-truck text-primary me-2"></i> White-Glove Logistics &amp; Installation Tracker</h5>
                    <div class="aura-order-timeline">
                        @foreach (var step in Model.Timeline)
                        {
                            <div class="aura-timeline-step @(step.IsCompleted ? "completed" : "") @(step.IsCurrent ? "current" : "")">
                                <div class="aura-timeline-dot"></div>
                                <div class="fw-bold text-dark">@step.Title</div>
                                <p class="text-muted small mb-1">@step.Description</p>
                                <small class="text-secondary fw-semibold">@step.Timestamp</small>
                            </div>
                        }
                    </div>
                </div>

                <!-- Order Line Items -->
                <h5 class="fw-bold text-dark mb-3">Items in This Shipment</h5>
                <div class="d-flex flex-column gap-3 mb-4">
                    @foreach (var itm in Model.Items)
                    {
                        <div class="p-3 rounded-3 border bg-white shadow-sm d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-white p-2 rounded-3 border text-center" style="width: 64px; height: 64px;">
                                    <img src="@itm.Image" alt="@itm.ProductName" class="img-fluid h-100 object-fit-contain" referrerpolicy="no-referrer" onerror="this.onerror=null;this.src='/images/homixa_hero_appliances.jpg';" />
                                </div>
                                <div>
                                    <h6 class="fw-bold text-dark mb-1 fs-6">
                                        <a href="/product/@itm.ProductSlug" class="text-dark text-decoration-none">@itm.ProductName</a>
                                    </h6>
                                    <small class="text-muted">Quantity: <strong>@itm.Quantity</strong> @(!string.IsNullOrEmpty(itm.SelectedCapacity) ? "• " + itm.SelectedCapacity : "")</small>
                                </div>
                            </div>
                            <div class="text-end">
                                <div class="fw-bold text-dark fs-6">₹@itm.Total.ToString("N0")</div>
                                <small class="text-muted">₹@itm.Price.ToString("N0") each</small>
                            </div>
                        </div>
                    }
                </div>

                <!-- Delivery Address & Payment Summary -->
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="p-4 rounded-4 border bg-light h-100">
                            <h6 class="fw-bold text-dark mb-2"><i class="bi bi-geo-alt-fill text-primary me-2"></i> Delivery Address</h6>
                            <div class="small text-secondary style-readable" style="line-height: 1.6;">
                                <strong class="text-dark">@Model.ShippingAddress.FullName</strong> <span class="badge bg-secondary ms-1">@Model.ShippingAddress.Type</span><br />
                                @Model.ShippingAddress.AddressLine1 @(!string.IsNullOrEmpty(Model.ShippingAddress.AddressLine2) ? ", " + Model.ShippingAddress.AddressLine2 : "")<br />
                                @Model.ShippingAddress.City, @Model.ShippingAddress.State - <strong>@Model.ShippingAddress.Pincode</strong><br />
                                Phone: <strong>@Model.ShippingAddress.Phone</strong>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-4 rounded-4 border bg-light h-100">
                            <h6 class="fw-bold text-dark mb-2"><i class="bi bi-credit-card-2-front-fill text-primary me-2"></i> Payment Summary</h6>
                            <div class="d-flex justify-content-between small text-secondary mb-1">
                                <span>Subtotal</span>
                                <span class="text-dark fw-bold">₹@Model.SubTotal.ToString("N0")</span>
                            </div>
                            <div class="d-flex justify-content-between small text-success mb-1">
                                <span>Promotional Discount</span>
                                <span class="fw-bold">-₹@Model.Discount.ToString("N0")</span>
                            </div>
                            <div class="d-flex justify-content-between small text-secondary mb-1">
                                <span>White-Glove Shipping</span>
                                <span class="text-success fw-bold">FREE</span>
                            </div>
                            <hr class="my-2" />
                            <div class="d-flex justify-content-between fw-bold text-dark fs-5">
                                <span>Grand Total</span>
                                <span>₹@Model.GrandTotal.ToString("N0")</span>
                            </div>
                            <small class="text-muted d-block mt-2">Payment Method: <strong>@Model.PaymentMethod</strong></small>
                        </div>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top d-flex gap-2">
                    <a href="/account/returns" class="btn btn-outline-danger btn-sm rounded-pill px-4">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Request Return / Replacement
                    </a>
                    <a href="/help" class="btn btn-outline-secondary btn-sm rounded-pill px-4 ms-auto">
                        <i class="bi bi-headset me-1"></i> Priority Support
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.Status != "Cancelled" && Model.Status != "Delivered")
{
    <!-- Cancel Order Reason Modal -->
    <div class="modal fade" id="cancelOrderModal" tabindex="-1" aria-labelledby="cancelOrderModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow-lg">
                <div class="modal-header border-bottom p-4">
                    <h5 class="modal-title fw-bold text-dark mb-0" id="cancelOrderModalLabel">
                        <i class="bi bi-exclamation-triangle-fill text-danger me-2"></i> Cancel Order #@Model.Id
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="cancelOrderForm" onsubmit="submitOrderCancellation(event, '@Model.Id')">
                    <div class="modal-body p-4">
                        <p class="text-secondary small mb-3">
                            Are you sure you want to cancel this order? Please select a reason below to help us process your cancellation.
                        </p>

                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark small">Reason for Cancellation <span class="text-danger">*</span></label>
                            <div class="d-flex flex-column gap-2">
                                <div class="form-check p-2.5 rounded-3 border bg-light">
                                    <input class="form-check-input ms-1 me-2" type="radio" name="cancelReason" id="reason1" value="Ordered by mistake" checked>
                                    <label class="form-check-label fw-semibold text-dark small" for="reason1">Ordered by mistake / Duplicate order</label>
                                </div>
                                <div class="form-check p-2.5 rounded-3 border bg-light">
                                    <input class="form-check-input ms-1 me-2" type="radio" name="cancelReason" id="reason2" value="Found lower price elsewhere">
                                    <label class="form-check-label fw-semibold text-dark small" for="reason2">Found a better price elsewhere</label>
                                </div>
                                <div class="form-check p-2.5 rounded-3 border bg-light">
                                    <input class="form-check-input ms-1 me-2" type="radio" name="cancelReason" id="reason3" value="Delivery time is too long">
                                    <label class="form-check-label fw-semibold text-dark small" for="reason3">Delivery time is too long</label>
                                </div>
                                <div class="form-check p-2.5 rounded-3 border bg-light">
                                    <input class="form-check-input ms-1 me-2" type="radio" name="cancelReason" id="reason4" value="Need to change shipping or item details">
                                    <label class="form-check-label fw-semibold text-dark small" for="reason4">Need to change shipping or item details</label>
                                </div>
                                <div class="form-check p-2.5 rounded-3 border bg-light">
                                    <input class="form-check-input ms-1 me-2" type="radio" name="cancelReason" id="reason5" value="Other">
                                    <label class="form-check-label fw-semibold text-dark small" for="reason5">Other / Custom reason</label>
                                </div>
                            </div>
                        </div>

                        <div class="mb-2">
                            <label for="customCancelNotes" class="form-label fw-bold text-dark small">Manually Type Reason / Additional Notes</label>
                            <textarea class="form-control rounded-3" id="customCancelNotes" name="customCancelNotes" rows="3" placeholder="Type your reason or specific feedback here..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer border-top p-3 bg-light rounded-bottom-4">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Keep Order</button>
                        <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold" id="confirmCancelBtn">
                            <i class="bi bi-x-circle me-1"></i> Confirm Cancellation
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            async function submitOrderCancellation(e, orderId) {
                e.preventDefault();
                const form = e.target;
                const confirmBtn = document.getElementById('confirmCancelBtn');
                const selectedReason = form.querySelector('input[name="cancelReason"]:checked')?.value || 'Changed my mind';
                const customNotes = form.querySelector('#customCancelNotes')?.value || '';

                confirmBtn.disabled = true;
                confirmBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span> Cancelling...';

                try {
                    const response = await fetch(`/api/v1/orders/${orderId}/cancel`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            reason: selectedReason,
                            customReason: customNotes
                        })
                    });

                    const data = await response.json();
                    if (response.ok && data.success) {
                        if (typeof showAuraToast === 'function') {
                            showAuraToast(`Order #${orderId} has been cancelled successfully.`, 'success');
                        }
                        setTimeout(() => {
                            window.location.reload();
                        }, 1200);
                    } else {
                        alert(data.message || 'Error cancelling order.');
                        confirmBtn.disabled = false;
                        confirmBtn.innerHTML = '<i class="bi bi-x-circle me-1"></i> Confirm Cancellation';
                    }
                } catch (err) {
                    console.error('Cancellation failed', err);
                    alert('An error occurred while cancelling your order.');
                    confirmBtn.disabled = false;
                    confirmBtn.innerHTML = '<i class="bi bi-x-circle me-1"></i> Confirm Cancellation';
                }
            }
        </script>
    }
}
