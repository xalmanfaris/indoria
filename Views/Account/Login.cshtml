@model AuraLiving.Models.LoginRequestDto
@{
    ViewData["Title"] = "Sign In to Indoria";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="p-4 p-md-5 rounded-4 bg-white border shadow-sm text-center">
                <a href="/" class="aura-brand justify-content-center mb-3 text-decoration-none">
                    <span class="aura-brand-name">Indoria</span>
                </a>

                <h3 class="fw-bold text-dark mb-1">Sign In to Your Account</h3>
                <p class="text-muted small mb-4">Access your order tracking, luxury appliance suites, and account settings.</p>

                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="alert alert-danger rounded-3 py-2 px-3 small mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i> @ViewBag.ErrorMessage
                    </div>
                }

                <form method="post" action="/account/login" id="loginForm">
                    <div class="text-start mb-3">
                        <label class="form-label small fw-bold text-dark">Email Address</label>
                        <input type="email" id="emailInput" name="Email" class="form-control py-2.5" placeholder="name@example.com" value="@(Model?.Email ?? "")" required />
                    </div>

                    <div class="text-start mb-4">
                        <div class="d-flex justify-content-between">
                            <label class="form-label small fw-bold text-dark">Password</label>
                            <a href="#" class="small text-primary text-decoration-none" onclick="event.preventDefault(); showAuraToast('Password reset link sent to your email', 'dark');">Forgot?</a>
                        </div>
                        <input type="password" id="passwordInput" name="Password" class="form-control py-2.5" placeholder="••••••••" required />
                    </div>

                    <div class="form-check text-start mb-4">
                        <input class="form-check-input" type="checkbox" id="rememberMe" checked />
                        <label class="form-check-label small text-muted" for="rememberMe">
                            Keep me signed in on this device
                        </label>
                    </div>

                    <button type="submit" class="btn aura-btn-primary w-100 py-3 fw-bold rounded-pill mb-4 shadow-sm">
                        Sign In <i class="bi bi-arrow-right ms-1"></i>
                    </button>

                    <p class="small text-muted mb-0">
                        Don't have an Indoria account? <a href="/register" class="text-primary fw-bold text-decoration-none">Create Account</a>
                    </p>
                </form>
            </div>
        </div>
    </div>
</div>
