@{
    ViewData["Title"] = "Sign In to Indoria";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="p-4 p-md-5 rounded-4 bg-white border shadow-sm text-center">
                <a href="/" class="aura-brand justify-content-center mb-3 text-decoration-none">
                    <span class="aura-brand-name">Indoria</span>
                </a>

                <h3 class="fw-bold text-dark mb-1">Welcome Back</h3>
                <p class="text-muted small mb-4">Sign in to track orders, manage addresses, and access VIP appliance privileges.</p>

                <form onsubmit="event.preventDefault(); showAuraToast('Signed in successfully!', 'success'); setTimeout(() => location.href = '/account', 800);">
                    <div class="text-start mb-3">
                        <label class="form-label small fw-bold text-dark">Mobile Number or Email</label>
                        <input type="text" class="form-control" placeholder="e.g. 98201 45890 or user@example.com" value="arjun.mehta@example.com" required />
                    </div>

                    <div class="text-start mb-3">
                        <div class="d-flex justify-content-between">
                            <label class="form-label small fw-bold text-dark">Password</label>
                            <a href="#" class="small text-primary text-decoration-none" onclick="event.preventDefault(); showAuraToast('Password reset link sent to your email', 'dark');">Forgot?</a>
                        </div>
                        <input type="password" class="form-control" placeholder="••••••••" value="password123" required />
                    </div>

                    <div class="form-check text-start mb-4">
                        <input class="form-check-input" type="checkbox" id="rememberMe" checked />
                        <label class="form-check-label small text-muted" for="rememberMe">
                            Keep me signed in on this device
                        </label>
                    </div>

                    <button type="submit" class="btn aura-btn-primary w-100 py-3 fw-bold rounded-pill mb-3">
                        Sign In <i class="bi bi-arrow-right ms-1"></i>
                    </button>

                    <div class="position-relative my-4">
                        <hr />
                        <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 small text-muted">OR</span>
                    </div>

                    <button type="button" class="btn btn-outline-secondary w-100 py-2 rounded-pill small mb-4" onclick="showAuraToast('OTP sent to your registered mobile', 'dark');">
                        <i class="bi bi-phone me-1"></i> Sign In with One-Time OTP
                    </button>

                    <p class="small text-muted mb-0">
                        Don't have an Indoria account? <a href="/register" class="text-primary fw-bold text-decoration-none">Create Account</a>
                    </p>
                </form>
            </div>
        </div>
    </div>
</div>
