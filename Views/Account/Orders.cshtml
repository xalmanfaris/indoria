@model List<AuraLiving.Models.OrderViewModel>
@{
    ViewData["Title"] = "My Orders History";
    var breadcrumbs = new List<(string Title, string Url)>
    {
        ("My Account", "/account"),
        ("Orders History", "")
    };
}

<div class="container py-4">
    <partial name="_Breadcrumb" model="breadcrumbs" />

    <div class="row g-4">
        <div class="col-lg-3">
            <partial name="_AccountSidebar" />
        </div>

        <div class="col-lg-9">
            <div class="p-4 p-md-5 rounded-4 bg-white border shadow-sm">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom gap-3">
                    <div>
                        <h3 class="fw-bold text-dark mb-1">My Orders &amp; Dispatches</h3>
                        <p class="text-secondary small mb-0">Track active dispatches, view invoices, and manage warranty certificates.</p>
                    </div>
                    <div class="d-flex gap-2">
                        <select class="form-select form-select-sm rounded-pill" style="width: 140px;">
                            <option>All Orders</option>
                            <option>Year 2026</option>
                            <option>Year 2025</option>
                        </select>
                    </div>
                </div>

                @if (!Model.Any())
                {
                    <div class="text-center py-5 bg-light rounded-4 border p-5">
                        <i class="bi bi-box-seam text-muted opacity-50 display-3 mb-3"></i>
                        <h4 class="fw-bold text-dark">No Orders Found</h4>
                        <p class="text-muted small mb-4">You haven't placed any appliance orders yet.</p>
                        <a href="/products" class="btn aura-btn-primary rounded-pill px-4 py-2 fw-bold">Browse Catalog</a>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-4">
                        @foreach (var order in Model)
                        {
                            <div class="p-4 rounded-4 border bg-white shadow-sm hover-shadow transition-all">
                                <!-- Order Header -->
                                <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 pb-3 border-bottom gap-2">
                                    <div>
                                        <span class="badge bg-light text-dark border me-2 font-monospace">#@order.Id</span>
                                        <span class="text-muted small">Placed on <strong>@order.OrderDate.ToString("dd MMM yyyy")</strong></span>
                                    </div>
                                    <div>
                                        <span class="badge @(order.Status == "Delivered" ? "bg-success" : "bg-primary") px-3 py-1.5 rounded-pill fw-bold">
                                            <i class="bi bi-truck me-1"></i> @order.Status
                                        </span>
                                    </div>
                                </div>

                                <!-- Items in Order -->
                                <div class="d-flex flex-column gap-3 mb-3">
                                    @foreach (var itm in order.Items)
                                    {
                                        <div class="d-flex align-items-center justify-content-between p-2 rounded-3 bg-light bg-opacity-50">
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="bg-white p-2 rounded-3 border text-center" style="width: 60px; height: 60px;">
                                                    <img src="@itm.Image" alt="@itm.ProductName" class="img-fluid h-100 object-fit-contain" referrerpolicy="no-referrer" onerror="this.onerror=null;this.src='/images/homixa_hero_appliances.jpg';" />
                                                </div>
                                                <div>
                                                    <h6 class="fw-bold text-dark mb-1" style="font-size: 0.95rem;">
                                                        <a href="/product/@itm.ProductSlug" class="text-dark text-decoration-none">@itm.ProductName</a>
                                                    </h6>
                                                    <small class="text-muted">Qty: <strong>@itm.Quantity</strong> @(!string.IsNullOrEmpty(itm.SelectedCapacity) ? "• " + itm.SelectedCapacity : "")</small>
                                                </div>
                                            </div>
                                            <div class="fw-bold text-dark">₹@itm.Total.ToString("N0")</div>
                                        </div>
                                    }
                                </div>

                                <!-- Footer & Actions -->
                                <div class="d-flex flex-wrap justify-content-between align-items-center pt-3 border-top gap-2">
                                    <div>
                                        <span class="text-muted small">Grand Total:</span>
                                        <strong class="text-dark fs-5 ms-1">₹@order.GrandTotal.ToString("N0")</strong>
                                        <span class="badge bg-light text-secondary border ms-2">@order.PaymentMethod</span>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <a href="/account/orders/@order.Id" class="btn aura-btn-primary btn-sm rounded-pill px-4 font-weight-bold">
                                            <i class="bi bi-geo-alt me-1"></i> Track &amp; Details
                                        </a>
                                        <button class="btn btn-outline-secondary btn-sm rounded-pill px-3" onclick="showAuraToast('Added items from order #@order.Id to bag', 'success');">
                                            <i class="bi bi-arrow-repeat me-1"></i> Buy Again
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
