@model AuraLiving.Models.ProfileViewModel
@{
    ViewData["Title"] = "Account Dashboard";
    var recentOrders = ViewBag.RecentOrders as List<AuraLiving.Models.OrderViewModel> ?? new List<AuraLiving.Models.OrderViewModel>();
    var addresses = ViewBag.Addresses as List<AuraLiving.Models.AddressViewModel> ?? new List<AuraLiving.Models.AddressViewModel>();
}

<div class="container py-4">
    <div class="row g-4">
        <!-- Sidebar Navigation -->
        <div class="col-lg-3">
            <partial name="_AccountSidebar" />
        </div>

        <!-- Main Account Content -->
        <div class="col-lg-9">
            <!-- Welcome Header Card -->
            <div class="p-4 rounded-4 bg-white border shadow-sm mb-4">
                <div class="row align-items-center g-3">
                    <div class="col-md-8">
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 mb-2">Indoria Privilege Tier</span>
                        <h2 class="fw-bold mb-1">Welcome back, @Model.FullName</h2>
                        <p class="text-secondary small mb-0">Member since @Model.MemberSince • You have <strong>@Model.RewardsPoints Indoria Points</strong> ready to redeem on your next appliance purchase.</p>
                    </div>
                    <div class="col-md-4 text-md-end">
                        <a href="/account/profile" class="btn aura-btn-outline btn-sm rounded-pill">
                            <i class="bi bi-pencil me-1"></i> Edit Profile
                        </a>
                    </div>
                </div>
            </div>

            <!-- Quick Metrics Grid -->
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="p-3 bg-white rounded-3 border shadow-sm d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; font-size: 1.3rem;">
                            <i class="bi bi-box-seam"></i>
                        </div>
                        <div>
                            <div class="fs-4 fw-bold text-dark">@Model.TotalOrders</div>
                            <small class="text-muted">Total Orders Placed</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-white rounded-3 border shadow-sm d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-warning-subtle text-warning d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; font-size: 1.3rem;">
                            <i class="bi bi-coin"></i>
                        </div>
                        <div>
                            <div class="fs-4 fw-bold text-dark">@Model.RewardsPoints</div>
                            <small class="text-muted">Rewards Points (₹@((Model.RewardsPoints / 10).ToString("N0")) Value)</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-white rounded-3 border shadow-sm d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-danger-subtle text-danger d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; font-size: 1.3rem;">
                            <i class="bi bi-heart"></i>
                        </div>
                        <div>
                            <div class="fs-4 fw-bold text-dark">@Model.WishlistCount</div>
                            <small class="text-muted">Wishlist Items</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Active Order Snapshot -->
            @if (recentOrders.Any())
            {
                var activeOrder = recentOrders.First();
                <div class="p-4 rounded-4 bg-white border shadow-sm mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <span class="text-uppercase fw-bold text-muted small">Active Shipment</span>
                            <h5 class="fw-bold text-dark mb-0">Order #@activeOrder.Id</h5>
                        </div>
                        <span class="badge bg-primary px-3 py-2">@activeOrder.Status</span>
                    </div>

                    <div class="p-3 bg-light rounded-3 mb-3 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
                        <div>
                            <i class="bi bi-truck text-primary me-2"></i> <strong>Estimated Arrival:</strong> @activeOrder.EstimatedDelivery
                        </div>
                        <a href="/account/orders/@activeOrder.Id" class="btn aura-btn-primary btn-sm rounded-pill px-3">
                            Track Shipment <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>

                    <div class="d-flex flex-column gap-2">
                        @foreach (var itm in activeOrder.Items)
                        {
                            <div class="d-flex align-items-center justify-content-between py-2 border-bottom">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@itm.Image" alt="@itm.ProductName" style="width: 44px; height: 44px; object-fit: contain;" />
                                    <div>
                                        <div class="fw-bold text-dark small">@itm.ProductName</div>
                                        <small class="text-muted">Qty: @itm.Quantity • ₹@itm.Price.ToString("N0")</small>
                                    </div>
                                </div>
                                <span class="fw-bold text-dark small">₹@itm.Total.ToString("N0")</span>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Saved Addresses Summary -->
            <div class="p-4 rounded-4 bg-white border shadow-sm">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark mb-0">Default Delivery Address</h5>
                    <a href="/account/addresses" class="text-primary small text-decoration-none fw-semibold">Manage Addresses &rarr;</a>
                </div>
                @if (addresses.Any())
                {
                    var def = addresses.First(a => a.IsDefault);
                    <div class="p-3 bg-light rounded-3">
                        <div class="fw-bold text-dark mb-1">@def.FullName <span class="badge bg-primary ms-1">@def.Type</span></div>
                        <div class="small text-secondary">
                            @def.AddressLine1, @def.AddressLine2<br />
                            @def.City, @def.State - <strong>@def.Pincode</strong><br />
                            Phone: @def.Phone
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
