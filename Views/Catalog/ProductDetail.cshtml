@model AuraLiving.Models.ProductViewModel
@{
    ViewData["Title"] = $"{Model.Name} - Specifications & Offers";
    var related = ViewBag.RelatedProducts as List<AuraLiving.Models.ProductViewModel> ?? new List<AuraLiving.Models.ProductViewModel>();
    var breadcrumbs = new List<(string Title, string Url)>
    {
        ("Categories", "/categories"),
        (Model.Category, $"/category/{Model.CategorySlug}"),
        (Model.Name, "")
    };
}

<div class="container py-4">
    <partial name="_Breadcrumb" model="breadcrumbs" />

    <!-- Main Product Grid: Gallery + Purchasing Details -->
    <div class="row g-4 g-lg-5 mb-5">
        <!-- Image Gallery -->
        <div class="col-lg-6">
            <div class="sticky-top" style="top: 90px;">
                <!-- Main Image Preview -->
                <div class="aura-pdp-gallery-main position-relative">
                    <button class="aura-wishlist-btn" title="Add to Wishlist" data-product-name="@Model.Name">
                        <i class="bi bi-heart"></i>
                    </button>
                    @if (Model.EnergyRating >= 4)
                    {
                        <span class="position-absolute top-0 start-0 m-3 badge bg-warning text-dark px-3 py-2 fw-bold">
                            <i class="bi bi-lightning-charge-fill"></i> @Model.EnergyRating★ Energy Rated
                        </span>
                    }
                    <img id="pdpMainImage" src="@Model.MainImage" alt="@Model.Name" class="img-fluid" />
                </div>

                <!-- Thumbnails -->
                @if (Model.GalleryImages.Any())
                {
                    <div class="aura-pdp-thumb-list">
                        <div class="aura-pdp-thumb active" data-src="@Model.MainImage">
                            <img src="@Model.MainImage" alt="Angle 1" />
                        </div>
                        @for (int i = 0; i < Model.GalleryImages.Count; i++)
                        {
                            <div class="aura-pdp-thumb" data-src="@Model.GalleryImages[i]">
                                <img src="@Model.GalleryImages[i]" alt="Angle @(i + 2)" />
                            </div>
                        }
                    </div>
                }

                <!-- Trust Guarantee Pills -->
                <div class="row g-2 mt-4 text-center">
                    <div class="col-4">
                        <div class="p-2 rounded-3 bg-white border small">
                            <i class="bi bi-patch-check text-primary fs-5 d-block mb-1"></i>
                            <strong class="d-block">100% Genuine</strong>
                            <span class="text-muted" style="font-size: 0.7rem;">Direct brand warranty</span>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="col-4 w-100 p-2 rounded-3 bg-white border small">
                            <i class="bi bi-tools text-primary fs-5 d-block mb-1"></i>
                            <strong class="d-block">Free Installation</strong>
                            <span class="text-muted" style="font-size: 0.7rem;">Brand authorized tech</span>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="col-4 w-100 p-2 rounded-3 bg-white border small">
                            <i class="bi bi-arrow-repeat text-primary fs-5 d-block mb-1"></i>
                            <strong class="d-block">15-Day Return</strong>
                            <span class="text-muted" style="font-size: 0.7rem;">Zero-hassle pickup</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Product Purchasing Details -->
        <div class="col-lg-6">
            <!-- Brand & SKU -->
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-uppercase fw-bold text-primary small letter-spacing-1">@Model.Brand</span>
                <span class="text-muted small">SKU: @Model.Id</span>
            </div>

            <!-- Title -->
            <h1 class="h2 fw-bold text-dark mb-3">@Model.Name</h1>

            <!-- Ratings & Stock Status -->
            <div class="d-flex flex-wrap align-items-center gap-3 mb-4 pb-3 border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-warning text-dark px-2 py-1">
                        @Model.Rating.ToString("0.0") <i class="bi bi-star-fill"></i>
                    </span>
                    <partial name="_RatingStars" model="Model.Rating" />
                    <a href="#reviewsSection" class="small text-muted text-decoration-none">(@Model.ReviewCount verified ratings)</a>
                </div>
                <span class="text-muted opacity-25">|</span>
                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1">
                    <i class="bi bi-check2-circle me-1"></i> In Stock (@Model.StockCount units ready)
                </span>
            </div>

            <!-- Price Breakdown -->
            <div class="mb-4">
                <div class="d-flex align-items-baseline gap-3 mb-1">
                    <span class="display-6 fw-bold text-dark">₹@Model.Price.ToString("N0")</span>
                    @if (Model.OriginalPrice > Model.Price)
                    {
                        <span class="fs-5 text-muted text-decoration-line-through">₹@Model.OriginalPrice.ToString("N0")</span>
                        <span class="badge bg-success fs-6 fw-bold">Save ₹@((Model.OriginalPrice - Model.Price).ToString("N0")) (@Model.DiscountPercent% OFF)</span>
                    }
                </div>
                <small class="text-muted d-block">Inclusive of all taxes &amp; environmental cess. Free doorstep transit insurance included.</small>
            </div>

            <!-- Bank Offers / EMI Box -->
            <div class="p-3 rounded-3 bg-light border mb-4">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-tag-fill text-primary"></i>
                    <strong class="text-dark small">Premier Bank Offers Available</strong>
                </div>
                <ul class="list-unstyled mb-0 small text-secondary">
                    <li class="mb-1"><i class="bi bi-check-circle-fill text-success me-1"></i> Flat <strong>₹5,000 instant discount</strong> on HDFC &amp; ICICI Bank Credit Cards.</li>
                    <li><i class="bi bi-check-circle-fill text-success me-1"></i> No Cost EMI from <strong>₹@Model.EmiPerMonth.ToString("N0")/month</strong> for up to 24 months.</li>
                </ul>
            </div>

            <!-- Variant Selectors: Capacity & Color -->
            @if (Model.CapacityVariants.Any())
            {
                <div class="mb-3 aura-variant-group">
                    <label class="fw-bold small text-dark d-block mb-2">Select Capacity / Size:</label>
                    <div class="d-flex flex-wrap gap-2">
                        @for (int i = 0; i < Model.CapacityVariants.Count; i++)
                        {
                            <button type="button" class="aura-variant-pill @(i == 0 ? "active" : "")">
                                @Model.CapacityVariants[i]
                            </button>
                        }
                    </div>
                </div>
            }

            @if (Model.ColorVariants.Any())
            {
                <div class="mb-4 aura-variant-group">
                    <label class="fw-bold small text-dark d-block mb-2">Select Finish &amp; Color:</label>
                    <div class="d-flex flex-wrap gap-2">
                        @for (int i = 0; i < Model.ColorVariants.Count; i++)
                        {
                            <button type="button" class="aura-variant-pill @(i == 0 ? "active" : "")">
                                <i class="bi bi-circle-fill text-secondary me-1" style="font-size: 0.7rem;"></i> @Model.ColorVariants[i]
                            </button>
                        }
                    </div>
                </div>
            }

            <!-- Pincode Delivery Estimator Demo -->
            <div class="aura-pincode-box">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <label class="fw-bold small text-dark mb-0">
                        <i class="bi bi-geo-alt me-1 text-primary"></i> Check Express Delivery &amp; Installation
                    </label>
                    <span class="text-muted small">Enter 6-digit PIN</span>
                </div>
                <div class="input-group input-group-sm">
                    <input type="text" id="pincodeInput" class="form-control" placeholder="e.g. 400001 or 560001" maxlength="6" value="400001" />
                    <button class="btn aura-btn-primary" type="button" id="checkPincodeBtn">Check Availability</button>
                </div>
                <div id="pincodeResult" class="mt-2 alert alert-success py-2 px-3 small d-flex align-items-center gap-2 mb-0">
                    <i class="bi bi-check-circle-fill text-success fs-6"></i>
                    <div>
                        <strong>Free Express Delivery to 400001</strong><br/>
                        <span class="text-muted">Estimated: @Model.DeliveryEstimate • Free Certified Demo Included</span>
                    </div>
                </div>
            </div>

            <!-- Quantity & Purchasing Buttons -->
            <div class="d-flex flex-column gap-3 mb-4">
                <div class="d-flex align-items-center gap-3">
                    <label class="fw-bold small text-dark">Quantity:</label>
                    <div class="input-group input-group-sm aura-qty-stepper" style="width: 120px;">
                        <button class="btn btn-outline-secondary aura-qty-minus" type="button">-</button>
                        <input type="text" class="form-control text-center aura-qty-input fw-bold" value="1" readonly />
                        <button class="btn btn-outline-secondary aura-qty-plus" type="button">+</button>
                    </div>
                </div>

                <div class="d-flex gap-3">
                    <button class="btn aura-btn-dark py-3 px-4 flex-grow-1 fw-bold aura-btn-cart" data-product-name="@Model.Name">
                        <i class="bi bi-bag-plus me-2"></i> Add to Bag
                    </button>
                    <a href="/checkout" class="btn aura-btn-primary py-3 px-4 flex-grow-1 fw-bold text-center">
                        <i class="bi bi-lightning-charge me-1"></i> Buy Now
                    </a>
                </div>
            </div>

            <!-- Key Features Highlights -->
            @if (Model.KeyFeatures.Any())
            {
                <div class="p-3 rounded-3 bg-white border">
                    <h6 class="fw-bold mb-2">Key Highlights:</h6>
                    <ul class="list-unstyled mb-0 small text-secondary">
                        @foreach (var feature in Model.KeyFeatures)
                        {
                            <li class="mb-2 d-flex align-items-start gap-2">
                                <i class="bi bi-check-circle-fill text-primary flex-shrink-0 mt-1"></i>
                                <span>@feature</span>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>

    <!-- Tabbed Detailed Information: Specs, Description, Warranty & Reviews -->
    <div class="bg-white rounded-4 border p-4 p-md-5 mb-5 shadow-sm">
        <ul class="nav nav-tabs nav-fill mb-4" id="pdpTab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active fw-bold py-3" id="specs-tab" data-bs-toggle="tab" data-bs-target="#specs" type="button" role="tab">
                    <i class="bi bi-list-check me-2"></i> Technical Specifications
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-bold py-3" id="overview-tab" data-bs-toggle="tab" data-bs-target="#overview" type="button" role="tab">
                    <i class="bi bi-info-circle me-2"></i> Product Overview
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-bold py-3" id="warranty-tab" data-bs-toggle="tab" data-bs-target="#warranty" type="button" role="tab">
                    <i class="bi bi-shield-check me-2"></i> Warranty &amp; Installation
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-bold py-3" id="reviews-tab" data-bs-toggle="tab" data-bs-target="#reviewsSection" type="button" role="tab">
                    <i class="bi bi-chat-left-text me-2"></i> Verified Reviews (@Model.ReviewCount)
                </button>
            </li>
        </ul>

        <div class="tab-content" id="pdpTabContent">
            <!-- Technical Specs Table -->
            <div class="tab-pane fade show active" id="specs" role="tabpanel">
                <h4 class="fw-bold mb-3">Complete Engineering Specifications</h4>
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle border">
                        <tbody>
                            @foreach (var spec in Model.Specifications)
                            {
                                <tr>
                                    <th class="text-secondary fw-semibold py-3 px-4" style="width: 35%;">@spec.Key</th>
                                    <td class="text-dark fw-medium py-3 px-4">@spec.Value</td>
                                </tr>
                            }
                            <tr>
                                <th class="text-secondary fw-semibold py-3 px-4">Country of Origin</th>
                                <td class="text-dark fw-medium py-3 px-4">India / Assembled with Imported Precision Components</td>
                            </tr>
                            <tr>
                                <th class="text-secondary fw-semibold py-3 px-4">In The Box</th>
                                <td class="text-dark fw-medium py-3 px-4">1x Main Appliance Unit, Certified Power Cord, Civil Installation Kit, User Manual &amp; Indoria Official 2-Year Warranty Card</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Overview -->
            <div class="tab-pane fade" id="overview" role="tabpanel">
                <h4 class="fw-bold mb-3">Architectural Philosophy &amp; Craft</h4>
                <p class="text-secondary mb-4" style="font-size: 1.05rem; line-height: 1.8;">
                    @Model.FullDescription
                </p>
                <div class="row g-4 mt-2">
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3">
                            <h6 class="fw-bold text-dark mb-1">Acoustic Engineering</h6>
                            <p class="text-muted small mb-0">Engineered with sound-dampening insulation and brushless inverter motors for near-inaudible performance in open-concept kitchens.</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3">
                            <h6 class="fw-bold text-dark mb-1">Intelligent Power Usage</h6>
                            <p class="text-muted small mb-0">Microprocessors continuously tune active cooling and heating power based on real-time room temperature and load density.</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3">
                            <h6 class="fw-bold text-dark mb-1">Sustainable Longevity</h6>
                            <p class="text-muted small mb-0">Constructed from anti-corrosion marine-grade alloys, reinforced tempered safety glass, and recyclable eco-polymers.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Warranty & Installation -->
            <div class="tab-pane fade" id="warranty" role="tabpanel">
                <h4 class="fw-bold mb-3">Indoria White-Glove Support &amp; Official Warranty</h4>
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="p-4 border rounded-3 bg-light h-100">
                            <h5 class="fw-bold text-dark mb-3"><i class="bi bi-shield-check text-primary me-2"></i> Comprehensive Warranty</h5>
                            <p class="text-secondary small mb-2">Every appliance purchased through Indoria includes:</p>
                            <ul class="small text-secondary ps-3">
                                <li><strong>@Model.WarrantyYears Years</strong> comprehensive on-site manufacturer warranty.</li>
                                <li><strong>Up to 10-20 Years</strong> warranty on key motor / compressor / inverter components.</li>
                                <li>Direct priority dispatch of brand certified engineers with zero service charges during coverage.</li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-4 border rounded-3 bg-light h-100">
                            <h5 class="fw-bold text-dark mb-3"><i class="bi bi-truck-flatbed text-primary me-2"></i> Free Certified Installation</h5>
                            <p class="text-secondary small mb-2">How your delivery and setup unfolds:</p>
                            <ul class="small text-secondary ps-3">
                                <li>White-glove delivery fleet unboxes and inspects appliance in your presence.</li>
                                <li>Certified technicians execute level placement, plumbing connection, and electrical safety check.</li>
                                <li>Technician performs live demo of primary modes and signs off warranty booklet.</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Verified Reviews -->
            <div class="tab-pane fade" id="reviewsSection" role="tabpanel">
                <div class="row g-4 mb-4">
                    <div class="col-lg-4 text-center border-end">
                        <div class="display-4 fw-bold text-dark">@Model.Rating.ToString("0.0")</div>
                        <partial name="_RatingStars" model="Model.Rating" />
                        <div class="text-muted small mt-2">Based on @Model.ReviewCount verified homeowner purchases</div>
                    </div>
                    <div class="col-lg-8">
                        <div class="d-flex align-items-center gap-3 mb-2">
                            <span class="small text-muted" style="width: 45px;">5 Star</span>
                            <div class="progress flex-grow-1" style="height: 8px;">
                                <div class="progress-bar bg-warning" style="width: 86%;"></div>
                            </div>
                            <span class="small text-muted" style="width: 35px;">86%</span>
                        </div>
                        <div class="d-flex align-items-center gap-3 mb-2">
                            <span class="small text-muted" style="width: 45px;">4 Star</span>
                            <div class="progress flex-grow-1" style="height: 8px;">
                                <div class="progress-bar bg-warning" style="width: 11%;"></div>
                            </div>
                            <span class="small text-muted" style="width: 35px;">11%</span>
                        </div>
                        <div class="d-flex align-items-center gap-3 mb-2">
                            <span class="small text-muted" style="width: 45px;">3 Star</span>
                            <div class="progress flex-grow-1" style="height: 8px;">
                                <div class="progress-bar bg-warning" style="width: 2%;"></div>
                            </div>
                            <span class="small text-muted" style="width: 35px;">2%</span>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <span class="small text-muted" style="width: 45px;">1-2 Star</span>
                            <div class="progress flex-grow-1" style="height: 8px;">
                                <div class="progress-bar bg-secondary" style="width: 1%;"></div>
                            </div>
                            <span class="small text-muted" style="width: 35px;">1%</span>
                        </div>
                    </div>
                </div>

                <!-- Review Cards -->
                <div class="d-flex flex-column gap-3 mt-4">
                    @if (Model.Reviews.Any())
                    {
                        @foreach (var rev in Model.Reviews)
                        {
                            <div class="p-4 rounded-3 border bg-light">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-primary text-white fw-bold d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; font-size: 0.85rem;">
                                            @rev.Author.Substring(0, 1)
                                        </div>
                                        <div>
                                            <strong class="d-block text-dark small">@rev.Author</strong>
                                            <span class="text-muted" style="font-size: 0.75rem;">@rev.City • @rev.Date</span>
                                        </div>
                                    </div>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle small">
                                        <i class="bi bi-patch-check-fill me-1"></i> Verified Owner
                                    </span>
                                </div>
                                <partial name="_RatingStars" model="(double)rev.Rating" />
                                <h6 class="fw-bold text-dark mt-2 mb-1">@rev.Title</h6>
                                <p class="text-secondary small mb-2">@rev.Comment</p>
                                <small class="text-muted"><i class="bi bi-hand-thumbs-up me-1"></i> @rev.HelpfulCount people found this review helpful</small>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="p-4 rounded-3 border bg-light text-center">
                            <p class="text-muted small mb-0">Be the first to review this new release!</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Related Products -->
    @if (related.Any())
    {
        <div class="mb-5">
            <div class="d-flex justify-content-between align-items-end mb-4">
                <div>
                    <span class="text-uppercase fw-bold text-primary small letter-spacing-1">Complementary Flagships</span>
                    <h3 class="fw-bold mb-0">Recommended In This Category</h3>
                </div>
                <a href="/category/@Model.CategorySlug" class="btn aura-btn-outline btn-sm rounded-pill px-3">
                    View More <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>

            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4">
                @foreach (var prod in related)
                {
                    <div class="col">
                        <partial name="_ProductCard" model="prod" />
                    </div>
                }
            </div>
        </div>
    }
</div>
