@model AuraLiving.Models.CatalogFilterViewModel
@{
    ViewData["Title"] = "All Appliances - Premium Home Electronics";
    var breadcrumbs = new List<(string Title, string Url)>
    {
        ("All Products", "")
    };
}

<div class="container py-4">
    <partial name="_Breadcrumb" model="breadcrumbs" />

    <!-- Banner Header -->
    <div class="p-4 p-md-5 rounded-4 bg-white border mb-4 shadow-sm">
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 mb-2">Full Collection</span>
        <h1 class="fw-bold mb-2">Explore Premium Home Appliances</h1>
        <p class="text-secondary mb-0">Engineered for architectural sophistication, energy efficiency, and reliable longevity. Backed by 100% genuine brand warranties.</p>
    </div>

    <!-- Product Grid & Filters -->
    <div class="row g-4">
        <!-- Filter Sidebar Desktop -->
        <div class="col-lg-3">
            <button class="btn btn-outline-dark w-100 d-lg-none mb-3" type="button" data-bs-toggle="collapse" data-bs-target="#mobileFilterCollapse" aria-expanded="false">
                <i class="bi bi-funnel me-1"></i> Filter &amp; Sort
            </button>
            <div class="collapse d-lg-block" id="mobileFilterCollapse">
                <partial name="_ProductListingFilter" model="Model" />
            </div>
        </div>

        <!-- Product Grid Area -->
        <div class="col-lg-9">
            <!-- Sort & Count Bar -->
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom gap-3">
                <div class="text-muted small">
                    Showing <strong class="text-dark">@Model.Products.Count</strong> of <strong class="text-dark">@Model.TotalCount</strong> appliances
                </div>
                
                <div class="d-flex align-items-center gap-2">
                    <label class="small text-muted text-nowrap">Sort by:</label>
                    <select class="form-select form-select-sm" style="width: 190px;" onchange="location.href = updateQueryString('sortBy', this.value);">
                        <option value="popularity" selected="@(Model.SortBy == "popularity")">Most Popular</option>
                        <option value="rating" selected="@(Model.SortBy == "rating")">Highest Rated</option>
                        <option value="price-low" selected="@(Model.SortBy == "price-low")">Price: Low to High</option>
                        <option value="price-high" selected="@(Model.SortBy == "price-high")">Price: High to Low</option>
                        <option value="newest" selected="@(Model.SortBy == "newest")">Newest Launches</option>
                    </select>
                </div>
            </div>

            <!-- Products -->
            @if (Model.Products.Any())
            {
                <div class="row row-cols-2 row-cols-md-2 row-cols-xl-3 g-2 g-sm-3 g-md-4">
                    @foreach (var prod in Model.Products)
                    {
                        <div class="col">
                            <partial name="_ProductCard" model="prod" />
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <nav class="mt-5 d-flex justify-content-center" aria-label="Page navigation">
                        <ul class="pagination pagination-sm">
                            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                                <a class="page-link" href="?page=@(Model.Page - 1)">Previous</a>
                            </li>
                            @for (int p = 1; p <= Model.TotalPages; p++)
                            {
                                <li class="page-item @(Model.Page == p ? "active" : "")">
                                    <a class="page-link" href="?page=@p">@p</a>
                                </li>
                            }
                            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" href="?page=@(Model.Page + 1)">Next</a>
                            </li>
                        </ul>
                    </nav>
                }
            }
            else
            {
                <!-- Empty State -->
                <div class="text-center py-5 bg-white rounded-4 border p-5">
                    <i class="bi bi-search text-muted opacity-50" style="font-size: 3.5rem;"></i>
                    <h4 class="fw-bold mt-3">No matching appliances found</h4>
                    <p class="text-muted small mb-4">Try adjusting your filters or search keywords.</p>
                    <a href="/products" class="btn aura-btn-primary px-4 py-2">
                        Reset All Filters
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<script>
    function updateQueryString(key, value) {
        const url = new URL(window.location.href);
        url.searchParams.set(key, value);
        return url.toString();
    }
</script>
