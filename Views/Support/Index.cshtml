@model List<AuraLiving.Services.Repositories.SupportTicket>
@{
    ViewData["Title"] = "Customer Support Tickets";
}

<div class="container py-4 py-md-5">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Home</a></li>
            <li class="breadcrumb-item"><a href="/account" class="text-decoration-none">Account</a></li>
            <li class="breadcrumb-item active" aria-current="page">Support Tickets</li>
        </ol>
    </nav>

    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Customer Support Center</h2>
            <p class="text-muted mb-0">Track your open inquiries, product assistance, and order resolution tickets.</p>
        </div>
        <button class="btn btn-primary rounded-pill px-4 py-2 d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#createTicketModal">
            <i class="bi bi-plus-lg"></i> Create Support Ticket
        </button>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="card shadow-sm border-0 rounded-4 p-5 text-center my-4">
            <div class="mb-3 text-muted">
                <i class="bi bi-headset display-3 text-primary"></i>
            </div>
            <h4 class="fw-bold text-dark">No Support Tickets Yet</h4>
            <p class="text-muted mx-auto" style="max-width: 480px;">Have questions about an appliance order, warranty, or delivery? Create a ticket and our 24/7 support team will assist you immediately.</p>
            <div>
                <button class="btn btn-outline-primary rounded-pill px-4 py-2" data-bs-toggle="modal" data-bs-target="#createTicketModal">
                    <i class="bi bi-ticket-perforated me-2"></i> Submit Inquiry
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Ticket ID</th>
                            <th>Subject</th>
                            <th>Category</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Last Updated</th>
                            <th class="text-end pe-4">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ticket in Model)
                        {
                            var statusBadge = ticket.Status switch
                            {
                                "Open" => "bg-warning text-dark",
                                "In Progress" => "bg-info text-dark",
                                "Customer Reply" => "bg-primary text-white",
                                "Resolved" => "bg-success text-white",
                                _ => "bg-secondary text-white"
                            };

                            var priorityBadge = ticket.Priority switch
                            {
                                "Urgent" => "text-danger fw-bold",
                                "High" => "text-warning fw-bold",
                                _ => "text-muted"
                            };

                            <tr>
                                <td class="ps-4 fw-bold text-primary">#@ticket.TicketNumber</td>
                                <td>
                                    <div class="fw-semibold text-dark">@ticket.Subject</div>
                                    <small class="text-muted">By @ticket.CustomerName (@ticket.Email)</small>
                                </td>
                                <td><span class="badge bg-light text-dark border">@ticket.Category</span></td>
                                <td><span class="@priorityBadge">@ticket.Priority</span></td>
                                <td><span class="badge rounded-pill @statusBadge">@ticket.Status</span></td>
                                <td><small class="text-muted">@ticket.UpdatedAt.ToString("MMM dd, yyyy HH:mm")</small></td>
                                <td class="text-end pe-4">
                                    <a href="/account/tickets/@ticket.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">View Details</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- Create Ticket Modal -->
<div class="modal fade" id="createTicketModal" tabindex="-1" aria-labelledby="createTicketModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="createTicketModalLabel"><i class="bi bi-headset me-2 text-primary"></i> Create Support Ticket</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="createTicketForm" onsubmit="submitCustomerTicket(event)">
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark small">Your Name</label>
                        <input type="text" class="form-control rounded-3" name="CustomerName" value="@User.Identity?.Name" required placeholder="Full Name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark small">Email Address</label>
                        <input type="email" class="form-control rounded-3" name="Email" value="@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value" required placeholder="name@example.com" />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold text-dark small">Category</label>
                            <select class="form-select rounded-3" name="Category">
                                <option value="Order Inquiry">Order Inquiry</option>
                                <option value="Technical Support">Technical Support</option>
                                <option value="Returns & Refunds">Returns & Refunds</option>
                                <option value="Warranty & Spares">Warranty & Spares</option>
                                <option value="Billing & Payment">Billing & Payment</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold text-dark small">Priority Level</label>
                            <select class="form-select rounded-3" name="Priority">
                                <option value="Low">Low</option>
                                <option value="Medium" selected>Medium</option>
                                <option value="High">High</option>
                                <option value="Urgent">Urgent</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark small">Subject</label>
                        <input type="text" class="form-control rounded-3" name="Subject" required placeholder="Brief summary of your inquiry..." />
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-semibold text-dark small">Detailed Message</label>
                        <textarea class="form-control rounded-3" name="Message" rows="4" required placeholder="Explain your issue or question in detail..."></textarea>
                    </div>
                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4">Submit Ticket</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
