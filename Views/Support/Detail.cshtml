@model AuraLiving.Services.Repositories.SupportTicket
@{
    ViewData["Title"] = $"Ticket #{Model.TicketNumber}";
    var messages = Model.GetMessages();
}

<div class="container py-4 py-md-5" style="max-width: 900px;">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Home</a></li>
            <li class="breadcrumb-item"><a href="/account/tickets" class="text-decoration-none">Support Tickets</a></li>
            <li class="breadcrumb-item active" aria-current="page">#@Model.TicketNumber</li>
        </ol>
    </nav>

    <!-- Ticket Summary Header Card -->
    <div class="card shadow-sm border-0 rounded-4 p-4 mb-4">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
            <div>
                <span class="badge bg-primary rounded-pill px-3 py-1 mb-2">@Model.Category</span>
                <h3 class="fw-bold text-dark mb-1">#@Model.TicketNumber: @Model.Subject</h3>
                <small class="text-muted">Opened by @Model.CustomerName (@Model.Email) on @Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</small>
            </div>
            <div class="text-end">
                <span class="badge bg-light text-dark border fs-6 me-2">Priority: @Model.Priority</span>
                <span class="badge bg-success text-white fs-6">Status: @Model.Status</span>
            </div>
        </div>
    </div>

    <!-- Messages Thread Container -->
    <div class="card shadow-sm border-0 rounded-4 p-4 mb-4">
        <h5 class="fw-bold mb-4 border-bottom pb-2"><i class="bi bi-chat-left-text me-2 text-primary"></i> Communication History</h5>

        <div class="d-flex flex-column gap-3 mb-4" id="ticketThreadList">
            @foreach (var msg in messages)
            {
                var isCustomer = msg.SenderRole == "Customer";
                var alignClass = isCustomer ? "ms-auto bg-primary text-white" : "me-auto bg-light text-dark border";

                <div class="card border-0 rounded-4 p-3 shadow-sm max-w-85 @alignClass" style="max-width: 80%;">
                    <div class="d-flex align-items-center justify-content-between gap-2 mb-1 opacity-75 small">
                        <span class="fw-bold">@msg.SenderName (@msg.SenderRole)</span>
                        <span>@msg.Timestamp.ToString("MMM dd, HH:mm")</span>
                    </div>
                    <div class="lh-base">@msg.MessageText</div>
                </div>
            }
        </div>

        <!-- Reply Form Box -->
        <form id="replyTicketForm" onsubmit="submitTicketReply(event, '@Model.Id')" class="border-top pt-3">
            <div class="mb-3">
                <label class="form-label fw-semibold text-dark small">Post a Reply</label>
                <textarea class="form-control rounded-3" name="Message" rows="3" required placeholder="Write your response..."></textarea>
            </div>
            <div class="d-flex justify-content-end">
                <button type="submit" class="btn btn-primary rounded-pill px-4">
                    <i class="bi bi-send-fill me-1"></i> Send Reply
                </button>
            </div>
        </form>
    </div>
</div>
